@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Reset Link Sent – SALU Examination Portal</PageTitle>

<div class="auth-shell">
    <section class="auth-board">
        <div class="auth-brand-header">
            <div class="auth-insignia">
                <img src="images/salu-logo.png" alt="SALU Crest" />
            </div>
            <div class="auth-titles">
                <h1 class="auth-uni-name">Shah Abdul Latif University</h1>
                <div class="auth-uni-sub">Khairpur, Sindh, Pakistan</div>
            </div>
        </div>

        <div class="auth-heading-block">
            <h2>Check Your Inbox</h2>
            <p>Password reset instructions have been dispatched</p>
        </div>

        <div class="p-3 mb-4 rounded" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #d1fae5;">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fs-5">✉️</span>
                <strong>Recovery Email Sent</strong>
            </div>
            <p class="m-0 small opacity-90">
                If an account exists for the specified Email / CNIC, you will receive a secure password reset link shortly. Please check your inbox and spam folder.
            </p>
        </div>

        <div class="d-grid">
            <a class="btn auth-btn-primary" href="/Account/Login">
                ← Return to Sign In
            </a>
        </div>

        <div class="auth-footer-simple">
            <p>Shah Abdul Latif University, Khairpur, Sindh</p>
        </div>
    </section>
</div>
