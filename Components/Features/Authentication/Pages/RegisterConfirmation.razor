@page "/Account/RegisterConfirmation"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using SaluExamPortal.Infrastructure.Persistence
@using SaluExamPortal.Domain.Enums
@using SaluExamPortal.Application.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailOtpService EmailOtpService
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verify Your Account – Shah Abdul Latif University Khairpur</PageTitle>

<div class="salu-auth-wrapper salu-auth-board">
    <div class="salu-card-container">
        <div class="salu-login-card salu-auth-card">
            
            <!-- CREST -->
            <div class="salu-crest-holder">
                <div class="salu-logo-wrapper">
                    <img src="images/salu-logo.png" alt="Shah Abdul Latif University Crest" class="salu-crest-img" />
                </div>
            </div>

            @if (isVerified)
            {
                <div class="salu-status-icon-wrapper success">
                    <i class="bi bi-shield-fill-check"></i>
                </div>

                <h2 class="salu-heading-main">Account Verified!</h2>
                <p class="salu-heading-sub">Your email has been successfully verified.</p>

                <div class="salu-message-card success">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    <span>Your account is now active. You can proceed directly to sign in and complete your admission application.</span>
                </div>

                <div class="salu-action-row mt-4">
                    <a href="@loginUrl" class="salu-login-btn">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Proceed to Sign In</span>
                    </a>
                </div>
            }
            else
            {
                <!-- KEY / SHIELD ICON -->
                <div class="salu-otp-icon-wrapper">
                    <div class="salu-icon-circle">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                </div>

                <h2 class="salu-heading-main">Enter Verification Code</h2>
                <p class="salu-heading-sub">We've sent a 6-digit OTP code to verify your account.</p>

                @if (!string.IsNullOrWhiteSpace(Email))
                {
                    <div class="salu-email-badge">
                        <i class="bi bi-envelope-check-fill me-2"></i>
                        <span class="email-text">@Email</span>
                    </div>
                }

                <div class="salu-expiry-badge mb-3">
                    <i class="bi bi-clock-history me-1"></i>
                    <span>Code is valid for <strong>30 minutes</strong></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="salu-message-card error mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(infoMessage))
                {
                    <div class="salu-message-card success mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <span>@infoMessage</span>
                    </div>
                }

                <EditForm Model="Input" FormName="verify-otp" OnValidSubmit="VerifyOtpAsync" method="post">
                    <DataAnnotationsValidator />

                    <div class="salu-form-group">
                        <label for="Input.OtpCode" class="salu-form-label justify-content-center">
                            <i class="bi bi-key-fill"></i>
                            6-Digit Verification OTP
                        </label>
                        <div class="salu-input-box">
                            <InputText @bind-Value="Input.OtpCode"
                                       id="Input.OtpCode"
                                       class="salu-text-input salu-otp-input"
                                       inputmode="numeric"
                                       maxlength="6"
                                       autocomplete="one-time-code"
                                       placeholder="••••••"
                                       aria-required="true" />
                        </div>
                        <ValidationMessage For="() => Input.OtpCode" class="text-danger small mt-1 text-center" />
                    </div>

                    <div class="salu-action-row mt-3 mb-2">
                        <button type="submit" class="salu-login-btn @(isVerifying ? "btn-loading" : "")" disabled="@isVerifying">
                            @if (isVerifying)
                            {
                                <span class="btn-spinner"></span>
                                <span>Verifying Code...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Verify &amp; Activate Account</span>
                            }
                        </button>
                    </div>
                </EditForm>

                <div class="salu-resend-box mt-3">
                    <span class="text-muted small">Didn't receive the code?</span>
                    <button type="button" class="btn btn-link salu-resend-link" @onclick="ResendOtpAsync" disabled="@isResending">
                        @if (isResending)
                        {
                            <span>Sending new code...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-1"></i>
                            <span>Resend 6-Digit Code</span>
                        }
                    </button>
                </div>

                <div class="salu-tip-box mt-2">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <span>Please check your <strong>Spam or Junk</strong> folder if not in inbox.</span>
                </div>
            }

            <div class="salu-footer-box mt-4">
                <div class="salu-copy-label">
                    <i class="bi bi-c-circle"></i> @DateTime.Now.Year SALU Directorate of Admissions
                </div>
                <a href="@loginUrl" class="salu-reg-link">
                    <i class="bi bi-box-arrow-in-left"></i>
                    Back to Sign In
                </a>
            </div>

        </div>
    </div>
</div>

