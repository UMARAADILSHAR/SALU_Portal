</style>

@code {
    private bool isVerifying = false;
    private bool isResending = false;
    private bool isVerified = false;
    private string? errorMessage;
    private string? infoMessage;
    private string loginUrl = "/Account/Login";

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (!string.IsNullOrWhiteSpace(Email))
        {
            var user = await UserManager.FindByEmailAsync(Email);
            if (user is not null)
            {
                if (user.AdmissionType == AdmissionType.UniversityRegular)
                {
                    loginUrl = "/Account/Login/Regular";
                }
                else
                {
                    loginUrl = "/Account/Login/Annual";
                }

                if (await UserManager.IsEmailConfirmedAsync(user))
                {
                    isVerified = true;
                }
            }
        }
    }

    private async Task VerifyOtpAsync()
    {
        isVerifying = true;
        errorMessage = null;
        infoMessage = null;

        if (string.IsNullOrWhiteSpace(Email))
        {
            errorMessage = "Missing email address. Please register or navigate to sign in.";
            isVerifying = false;
            return;
        }

        var cleanEmail = Email.Trim();
        var user = await UserManager.FindByEmailAsync(cleanEmail);
        if (user is null)
        {
            errorMessage = $"No candidate account found for {cleanEmail}.";
            isVerifying = false;
            return;
        }

        var result = await EmailOtpService.ValidateOtpAsync(user, Input.OtpCode);
        if (result.Succeeded)
        {
            isVerified = true;
            infoMessage = "Account verified successfully!";
            isVerifying = false;
            StateHasChanged();

            await Task.Delay(1500);
            RedirectManager.RedirectTo(loginUrl);
            return;
        }
        else
        {
            errorMessage = result.ErrorMessage;
            isVerifying = false;
        }
    }

    private async Task ResendOtpAsync()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            errorMessage = "Cannot resend code: Missing email address.";
            return;
        }

        isResending = true;
        errorMessage = null;
        infoMessage = null;

        var result = await EmailOtpService.ResendOtpAsync(Email);
        if (result.Succeeded)
        {
            infoMessage = result.Message;
        }
        else
        {
            errorMessage = result.Message;
        }

        isResending = false;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Please enter the 6-digit verification code.")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "OTP must be exactly 6 digits.")]
        public string OtpCode { get; set; } = "";
    }
}
