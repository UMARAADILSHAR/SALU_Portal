@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using SaluExamPortal.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Reset Password – Shah Abdul Latif University Khairpur</PageTitle>

<div class="salu-auth-wrapper">
    <svg class="salu-wave-backdrop" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <radialGradient id="saluBlueGrad" cx="25%" cy="50%" r="75%">
                <stop offset="0%" stop-color="#1b2e7e" stop-opacity="0.97" />
                <stop offset="60%" stop-color="#101d58" stop-opacity="0.98" />
                <stop offset="100%" stop-color="#091032" stop-opacity="0.99" />
            </radialGradient>
        </defs>
        <path d="M 0,0 L 760,0 C 720,380 700,600 950,900 L 0,900 Z" fill="url(#saluBlueGrad)" />
        <path d="M 760,0 C 720,380 700,600 950,900" fill="none" stroke="#ea580c" stroke-width="4" />
    </svg>

    <div class="salu-card-container">
        <div class="salu-login-card">
            
            <div class="salu-crest-holder">
                <img src="images/salu-logo.png" alt="Shah Abdul Latif University Crest" class="salu-crest-img" />
            </div>

            <h2 class="salu-heading-main">Forgot Password?</h2>
            <p class="salu-heading-sub">Enter your CNIC or registered Email to reset password</p>

            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small mb-3 text-start" role="alert" />

                <div class="salu-form-group">
                    <label for="Input.Email" class="salu-form-label">CNIC or Email <span class="text-danger">*</span></label>
                    <div class="salu-input-box">
                        <span class="salu-field-icon">👤</span>
                        <InputText @bind-Value="Input.Email" @oninput="FormatIdentifierInput" id="Input.Email" class="salu-text-input" autocomplete="username" aria-required="true" placeholder="45206-4702131-9 or Email" />
                    </div>
                    <ValidationMessage For="() => Input.Email" class="text-danger small mt-1 text-start" />
                </div>

                <div class="salu-action-row mt-3 mb-2">
                    <button type="submit" class="salu-login-btn">
                        Send Reset Link
                    </button>
                </div>
            </EditForm>

            <div class="salu-footer-box">
                <div class="salu-copy-label">Copyright © @DateTime.Now.Year SALU.</div>
                <a href="/Account/Login" class="salu-reg-link">← Return to Student Login</a>
            </div>

        </div>
    </div>
</div>

<style>
    .salu-auth-wrapper {
        min-height: 100vh;
        width: 100%;
        position: relative;
        background: url('images/salu-gate-bg.jpg') no-repeat right center / cover;
        background-attachment: fixed;
        display: flex;
        align-items: center;
        overflow-x: hidden;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    .salu-wave-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
        filter: drop-shadow(15px 0 35px rgba(0, 0, 0, 0.45));
    }

    .salu-card-container {
        position: relative;
        z-index: 2;
        margin-left: clamp(2.5rem, 7vw, 7.5rem);
        max-width: 430px;
        width: 100%;
        padding: 24px 0;
    }

    .salu-login-card {
        background: linear-gradient(180deg, #1b2c73 0%, #142054 100%);
        border: 2px solid #2563eb;
        border-radius: 36px;
        padding: 36px 32px 28px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        color: #ffffff;
        text-align: center;
    }

    .salu-crest-holder { margin: 0 auto 16px; display: flex; justify-content: center; }
    .salu-crest-img { width: 95px; height: 95px; object-fit: contain; filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.4)); }

    .salu-tabs-row { margin-bottom: 18px; }
    .salu-tab-btn {
        background: linear-gradient(180deg, #f97316 0%, #ea580c 100%);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 10px 0;
        border-radius: 6px;
        width: 100%;
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.35);
    }

    .salu-heading-main { font-size: 1.45rem; font-weight: 800; color: #ffffff; margin: 0 0 4px; }
    .salu-heading-sub { font-size: 0.82rem; color: #cbd5e1; margin: 0 0 22px; }

    .salu-form-group { text-align: left; margin-bottom: 16px; }
    .salu-form-label { display: block; font-size: 0.78rem; font-weight: 700; color: #ffffff; margin-bottom: 6px; }

    .salu-input-box { position: relative; display: flex; align-items: center; }
    .salu-field-icon { position: absolute; left: 12px; color: #94a3b8; font-size: 15px; pointer-events: none; }

    .salu-text-input {
        width: 100%;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 10px 14px 10px 38px !important;
        color: #1e293b !important;
        font-size: 0.9rem !important;
        font-weight: 600 !important;
        outline: none !important;
    }

    .salu-text-input:focus { border-color: #3b82f6 !important; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25) !important; }

    .salu-action-row { display: flex; justify-content: center; }
    .salu-login-btn {
        background: linear-gradient(180deg, #f97316 0%, #ea580c 100%) !important;
        color: #ffffff !important;
        font-weight: 800 !important;
        font-size: 1rem !important;
        padding: 11px 40px !important;
        border-radius: 8px !important;
        border: none !important;
        min-width: 180px !important;
        cursor: pointer !important;
        box-shadow: 0 4px 14px rgba(234, 88, 12, 0.4) !important;
    }

    .salu-footer-box { text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 16px; margin-top: 20px; }
    .salu-copy-label { font-size: 0.75rem; color: #94a3b8; margin-bottom: 4px; }
    .salu-reg-link { color: #e2e8f0; font-size: 0.85rem; font-weight: 600; text-decoration: none; }
    .salu-reg-link:hover { color: #fef08a; text-decoration: underline; }

    @@media (max-width: 992px) {
        .salu-wave-backdrop { display: none; }
        .salu-auth-wrapper {
            background: linear-gradient(180deg, rgba(13, 27, 76, 0.96) 0%, rgba(10, 16, 51, 0.98) 100%),
                        url('images/salu-gate-bg.jpg') no-repeat center / cover;
        }
        .salu-card-container { margin: 2rem auto; }
    }
</style>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var identifier = Input.Email.Trim();
        ApplicationUser? user = null;

        if (identifier.Contains('@'))
        {
            user = await UserManager.FindByEmailAsync(identifier);
        }
        else
        {
            var digits = new string(identifier.Where(char.IsDigit).ToArray());
            if (digits.Length == 13)
            {
                var formattedCnic = $"{digits[..5]}-{digits.Substring(5, 7)}-{digits[12]}";
                user = await UserManager.Users.FirstOrDefaultAsync(u => u.Cnic == formattedCnic);
            }
        }

        if (user is null)
        {
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code });

        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            await EmailSender.SendPasswordResetLinkAsync(user, user.Email, HtmlEncoder.Default.Encode(callbackUrl));
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private void FormatIdentifierInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (!raw.Contains('@') && digits.Length > 0 && !raw.Any(char.IsLetter))
        {
            if (digits.Length > 13) digits = digits[..13];
            Input.Email = digits.Length switch
            {
                <= 5 => digits,
                <= 12 => $"{digits[..5]}-{digits[5..]}",
                _ => $"{digits[..5]}-{digits.Substring(5, 7)}-{digits[12]}"
            };
        }
        else
        {
            Input.Email = raw;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Please enter your CNIC or registered email address.")]
        public string Email { get; set; } = "";
    }
}
