@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using SaluExamPortal.Infrastructure.Persistence
@using SaluExamPortal.Domain.Enums

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Email Verification – Shah Abdul Latif University Khairpur</PageTitle>

<div class="salu-auth-wrapper salu-auth-board">
    <div class="salu-card-container">
        <div class="salu-login-card salu-auth-card">
            
            <!-- CREST -->
            <div class="salu-crest-holder">
                <div class="salu-logo-wrapper">
                    <img src="images/salu-logo.png" alt="Shah Abdul Latif University Crest" class="salu-crest-img" />
                </div>
            </div>

            @if (isSuccess)
            {
                <div class="salu-status-icon-wrapper success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <h2 class="salu-heading-main">Email Verified!</h2>
                <p class="salu-heading-sub">Your student account has been successfully verified.</p>

                <div class="salu-message-card success">
                    <p class="mb-1"><strong>Verification Complete</strong></p>
                    <p class="text-muted small mb-0">You can now sign in with your credentials to fill and submit your admission application.</p>
                </div>

                <div class="salu-action-row mt-4">
                    <a href="@loginUrl" class="salu-login-btn">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Proceed to Sign In</span>
                    </a>
                </div>
            }
            else
            {
                <div class="salu-status-icon-wrapper error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <h2 class="salu-heading-main">Verification Issue</h2>
                <p class="salu-heading-sub">@(statusMessage ?? "The verification link is invalid or has expired.")</p>

                <div class="salu-message-card error">
                    <p class="mb-1"><strong>Action Required</strong></p>
                    <p class="text-muted small mb-0">For security purposes, verification links are time-limited. You can request a new verification link below.</p>
                </div>

                <div class="salu-action-row mt-4">
                    <a href="/Account/ResendEmailConfirmation" class="salu-login-btn">
                        <i class="bi bi-send-fill"></i>
                        <span>Resend Verification Email</span>
                    </a>
                </div>
            }

            <div class="salu-footer-box mt-4">
                <div class="salu-copy-label">
                    <i class="bi bi-c-circle"></i> @DateTime.Now.Year SALU Directorate of Admissions
                </div>
                <a href="/Account/Login" class="salu-reg-link">
                    <i class="bi bi-arrow-left"></i>
                    Back to Portal Home
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    * { box-sizing: border-box; }
    .salu-auth-wrapper {
        min-height: 100vh;
        width: 100%;
        position: relative;
        background: url('images/salu-login-bg.jpg') no-repeat center center / cover;
        background-attachment: fixed;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 24px 24px 24px clamp(2.5rem, 7vw, 7.5rem);
        overflow-x: hidden;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    .salu-card-container {
        position: relative;
        z-index: 2;
        max-width: 440px;
        width: 100%;
        margin: 0;
        padding: 8px 0;
        animation: cardFadeIn 0.5s ease;
    }

    @@keyframes cardFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .salu-login-card {
        background: rgba(13, 27, 62, 0.92);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 20px;
        padding: 28px 24px 22px;
        box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.2);
        color: #ffffff;
        text-align: center;
    }

    .salu-crest-holder { 
        margin: 0 auto 12px; 
        display: flex; 
        justify-content: center; 
    }

    .salu-logo-wrapper {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border-radius: 50%;
        padding: 4px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35), 0 0 0 2px rgba(249, 115, 22, 0.6);
    }

    .salu-crest-img { 
        width: 46px; 
        height: 46px; 
        object-fit: contain; 
    }

    .salu-status-icon-wrapper {
        font-size: 3rem;
        margin: 10px 0;
    }

    .salu-status-icon-wrapper.success {
        color: #4ade80;
        filter: drop-shadow(0 0 12px rgba(74, 222, 128, 0.4));
    }

    .salu-status-icon-wrapper.error {
        color: #f87171;
        filter: drop-shadow(0 0 12px rgba(248, 113, 113, 0.4));
    }

    .salu-heading-main { 
        font-size: 1.35rem; 
        font-weight: 800; 
        color: #ffffff; 
        margin: 0 0 6px;
    }

    .salu-heading-sub { 
        font-size: 0.82rem; 
        color: #cbd5e1; 
        margin: 0 0 16px; 
        font-weight: 500; 
        line-height: 1.4; 
    }

    .salu-message-card {
        padding: 14px 16px;
        border-radius: 12px;
        text-align: left;
        font-size: 0.82rem;
        margin: 14px 0;
    }

    .salu-message-card.success {
        background: rgba(34, 197, 94, 0.12);
        border: 1px solid rgba(34, 197, 94, 0.35);
        color: #bbf7d0;
    }

    .salu-message-card.error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #fecaca;
    }

    .salu-action-row {
        display: flex;
        justify-content: center;
    }

    .salu-login-btn {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%) !important;
        color: #ffffff !important;
        font-weight: 800 !important;
        font-size: 0.92rem !important;
        padding: 12px 32px !important;
        border-radius: 10px !important;
        text-decoration: none !important;
        cursor: pointer !important;
        box-shadow: 0 4px 16px rgba(234, 88, 12, 0.4) !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }

    .salu-login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(234, 88, 12, 0.5) !important;
    }

    .salu-footer-box { 
        border-top: 1px solid rgba(255, 255, 255, 0.12); 
        padding-top: 14px; 
    }

    .salu-copy-label { 
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 0.74rem; 
        color: #94a3b8; 
        margin-bottom: 8px; 
    }

    .salu-reg-link { 
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #e2e8f0; 
        font-size: 0.82rem; 
        font-weight: 700; 
        text-decoration: none;
    }

    .salu-reg-link:hover {
        color: #fef08a;
        text-decoration: underline;
    }
</style>

@code {
    private string? statusMessage;
    private bool isSuccess = false;
    private string loginUrl = "/Account/Login";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Email) && (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code)))
        {
            RedirectManager.RedirectTo($"Account/RegisterConfirmation", new() { ["email"] = Email });
            return;
        }

        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            statusMessage = "Missing user ID or confirmation code.";
            isSuccess = false;
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"User account not found for ID: {UserId}";
            isSuccess = false;
            return;
        }

        if (user.AdmissionType == AdmissionType.UniversityRegular)
        {
            loginUrl = "/Account/Login/Regular";
        }
        else
        {
            loginUrl = "/Account/Login/Annual";
        }

        try
        {
            var decodedCode = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, decodedCode);
            if (result.Succeeded)
            {
                user.IsVerified = true;
                await UserManager.UpdateAsync(user);
                isSuccess = true;
                statusMessage = "Email verified successfully.";
            }
            else
            {
                isSuccess = false;
                statusMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"Verification error: {ex.Message}";
        }
    }
}
