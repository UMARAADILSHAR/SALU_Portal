@code {
    private int _currentStep = 1;

    // Step 1 Data
    private List<string> _nationalities = [];
    private List<string> _provinces = [];
    private readonly List<string> _districts = ["Khairpur", "Sukkur", "Larkana", "Ghotki", "Shikarpur", "Kashmore", "Badin", "Hyderabad", "Karachi", "Nawabshah (SBA)", "Naushahro Feroze", "Dadu", "Jacobabad", "Mirpurkhas"];
    private string _photoError = "";

    // Step 2 Academic State
    private string _faculty = "", _dept = "", _program = "";
    private string _error = "";
    private List<string> _depts = [], _lastDegrees = [], _majors = [], _acadYears = [], _pgYears = [];
    private List<ProgramEntry> _programs = [];
    private List<IdNameItem> _examinations = [], _boards = [];
    private AcademicRecord _row = new();

    // Step 3 Preferences State
    private string _fac = "", _prefDept = "", _prog = "", _errPref = "";
    private List<string> _prefDepts = [];
    private List<ProgramEntry> _prefPrograms = [];

    // Step 4 Documents State
    private string _type = "", _name = "", _fileName = "", _errDoc = "";
    private List<DocumentType> _docTypes = [];

    // Step 5 Undertaking State
    private string _errUndertaking = "";

    // Step 6 Status State
    private bool _submitted = false;
    private bool _isSubmitting = false;
    private string _submissionError = "";
    private string _submittedTrackingNumber = "";

    protected override async Task OnInitializedAsync()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        if (relative.Equals("Student/UniversityAdmission/Form", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("Student/UniversityAdmission/submit-app", replace: true);
            return;
        }

        // Auto-fill logged in student profile details if empty
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                if (string.IsNullOrWhiteSpace(FormService.State.Personal.Name))
                    FormService.State.Personal.Name = user.FullName ?? "";
                if (string.IsNullOrWhiteSpace(FormService.State.Personal.Email))
                    FormService.State.Personal.Email = user.Email ?? "";
                if (string.IsNullOrWhiteSpace(FormService.State.Personal.Cnic))
                    FormService.State.Personal.Cnic = user.Cnic ?? "";
                if (string.IsNullOrWhiteSpace(FormService.State.Personal.MobileNo))
                    FormService.State.Personal.MobileNo = user.PhoneNumber ?? "";
            }
        }

        _nationalities = await SetupData.GetNationalitiesAsync();
        _provinces = await SetupData.GetProvincesAsync();

        _examinations = await SetupData.GetExaminationsAsync();
        _boards = await SetupData.GetBoardsAsync();
        _acadYears = await SetupData.GetAcademicYearsAsync();
        _pgYears = await SetupData.GetYearsForPGAsync();

        _docTypes = await SetupData.GetDocumentTypesAsync();

        // Restore existing state
        if (!string.IsNullOrWhiteSpace(FormService.State.Academics.Faculty))
        {
            _faculty = FormService.State.Academics.Faculty;
            _depts = SetupDataService.FacultyDepartmentsMap.TryGetValue(_faculty, out var d) ? d : [];
            _dept = FormService.State.Academics.Department;
            _programs = SetupDataService.DepartmentProgramsMap.TryGetValue(_dept, out var p) ? p : [];
            _program = FormService.State.Academics.Program;
            var entry = _programs.FirstOrDefault(pr => pr.Name == _program);
            if (entry != null)
            {
                _lastDegrees = [entry.Deg];
                _majors = entry.Majors;
            }
        }
    }

    private void GoToStep(int step)
    {
        if (step >= 1 && step <= 6)
            _currentStep = step;
    }

    private void NextStep()
    {
        if (_currentStep < 6)
            _currentStep++;
    }

    // ─── Step 1 Methods: Photo & Personal ────────────────────────────
    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 2 * 1024 * 1024)
        {
            _photoError = "Photograph size must not exceed 2 MB.";
            return;
        }

        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png")
        {
            _photoError = "Please select a valid JPG or PNG image.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            FormService.State.Personal.PhotoUrl = $"data:{file.ContentType};base64,{base64}";
            _photoError = "";
            Snackbar.Add("Candidate photograph uploaded successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            _photoError = "Failed to upload photo: " + ex.Message;
        }
    }

    private void RemovePhoto()
    {
        FormService.State.Personal.PhotoUrl = "";
        _photoError = "";
    }

    private void SavePersonal()
    {
        FormService.SavePersonal();
        NextStep();
    }

    // ─── Step 2 Methods: Academic ────────────────────────────────────
    private void OnFacultyChanged()
    {
        _dept = "";
        _program = "";
        _depts = SetupDataService.FacultyDepartmentsMap.TryGetValue(_faculty, out var d) ? d : [];
        _programs = [];
        _lastDegrees = [];
        _majors = [];
    }

    private void OnDeptChanged()
    {
        _program = "";
        _programs = SetupDataService.DepartmentProgramsMap.TryGetValue(_dept, out var p) ? p : [];
        _lastDegrees = [];
        _majors = [];
    }

    private void OnProgramChanged()
    {
        var entry = _programs.FirstOrDefault(p => p.Name == _program);
        if (entry != null)
        {
            _lastDegrees = [entry.Deg];
            _majors = entry.Majors;
            FormService.State.Academics.QualifyingDegree = entry.Deg;
            FormService.State.Academics.Faculty = _faculty;
            FormService.State.Academics.Department = _dept;
            FormService.State.Academics.Program = _program;
        }
    }

    private void AddAcademicRecord()
    {
        if (string.IsNullOrWhiteSpace(_row.Examination) || string.IsNullOrWhiteSpace(_row.GroupMajor) ||
            string.IsNullOrWhiteSpace(_row.Year) || string.IsNullOrWhiteSpace(_row.SeatNo) ||
            string.IsNullOrWhiteSpace(_row.ObtainedMarks) || string.IsNullOrWhiteSpace(_row.TotalMarks) ||
            string.IsNullOrWhiteSpace(_row.Board) || string.IsNullOrWhiteSpace(_row.Institute))
        {
            _error = "Please fill in all qualification fields before adding.";
            return;
        }

        _error = "";
        FormService.State.Academics.History.Add(new AcademicRecord
        {
            Examination = _row.Examination,
            GroupMajor = _row.GroupMajor,
            Year = _row.Year,
            SeatNo = _row.SeatNo,
            ObtainedMarks = _row.ObtainedMarks,
            TotalMarks = _row.TotalMarks,
            Board = _row.Board,
            Institute = _row.Institute
        });

        _row = new AcademicRecord();
        Snackbar.Add("Educational qualification added.", Severity.Info);
    }

    private void RemoveAcademicRecord(AcademicRecord rec)
    {
        FormService.State.Academics.History.Remove(rec);
    }

    private void SaveAcademics()
    {
        if (string.IsNullOrWhiteSpace(FormService.State.Academics.Faculty) ||
            string.IsNullOrWhiteSpace(FormService.State.Academics.Department) ||
            string.IsNullOrWhiteSpace(FormService.State.Academics.Program))
        {
            _error = "Please select Faculty, Department, and Program.";
            return;
        }

        if (!FormService.State.Academics.History.Any())
        {
            _error = "Please add at least one qualification record (e.g. SSC/HSC) before proceeding.";
            return;
        }

        _error = "";
        FormService.SaveAcademics();
        NextStep();
    }

    // ─── Step 3 Methods: Preferences ─────────────────────────────────
    private void OnPrefFacultyChanged()
    {
        _prefDept = "";
        _prog = "";
        _prefDepts = SetupDataService.FacultyDepartmentsMap.TryGetValue(_fac, out var d) ? d : [];
        _prefPrograms = [];
    }

    private void OnPrefDeptChanged()
    {
        _prog = "";
        _prefPrograms = SetupDataService.DepartmentProgramsMap.TryGetValue(_prefDept, out var p) ? p : [];
    }

    private void AddPreference()
    {
        if (string.IsNullOrWhiteSpace(_fac) || string.IsNullOrWhiteSpace(_prefDept) || string.IsNullOrWhiteSpace(_prog))
        {
            _errPref = "Please select Faculty, Department, and Program for your choice.";
            return;
        }

        if (FormService.State.Preferences.Any(p => p.Program == _prog))
        {
            _errPref = "This program choice is already added in your preferences list.";
            return;
        }

        _errPref = "";
        FormService.State.Preferences.Add(new PreferenceRecord
        {
            Faculty = _fac,
            Department = _prefDept,
            Program = _prog
        });

        _fac = ""; _prefDept = ""; _prog = "";
        _prefDepts = []; _prefPrograms = [];
        Snackbar.Add("Program choice added.", Severity.Info);
    }

    private void RemovePreference(PreferenceRecord pref)
    {
        FormService.State.Preferences.Remove(pref);
    }

    private void SavePreferences()
    {
        FormService.SavePreferences();
        NextStep();
    }

    // ─── Step 4 Methods: Documents ───────────────────────────────────
    private void HandleDocFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            _fileName = file.Name;
            _errDoc = "";
        }
    }

    private void AddDocument()
    {
        if (string.IsNullOrWhiteSpace(_type) || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_fileName))
        {
            _errDoc = "Please select document type, enter document title, and choose a file.";
            return;
        }

        _errDoc = "";
        FormService.State.Documents.Add(new DocumentRecord
        {
            DocType = _type,
            DocName = _name,
            FileName = _fileName
        });

        _type = ""; _name = ""; _fileName = "";
        Snackbar.Add("Document attached successfully.", Severity.Info);
    }

    private void RemoveDocument(DocumentRecord doc)
    {
        FormService.State.Documents.Remove(doc);
    }

    private void SaveDocuments()
    {
        if (!FormService.State.Documents.Any())
        {
            _errDoc = "Please upload at least one required educational document.";
            return;
        }

        _errDoc = "";
        FormService.SaveDocuments();
        NextStep();
    }

    // ─── Step 5 Methods: Undertaking ─────────────────────────────────
    private void SaveUndertaking()
    {
        if (!FormService.State.UndertakingAccepted)
        {
            _errUndertaking = "Please review and check the declaration box before proceeding.";
            return;
        }

        _errUndertaking = "";
        FormService.SaveUndertaking();
        NextStep();
    }

    // ─── Step 6 Methods: Final Submission ────────────────────────────
    private async Task SubmitForm()
    {
        if (!FormService.State.AllMandatoryComplete) return;

        _isSubmitting = true;
        _submissionError = "";

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId))
            {
                _submissionError = "Your session could not be verified. Please sign in again.";
                _isSubmitting = false;
                return;
            }

            await ApplicationStore.SaveDraftAsync(userId, FormService.State);
            _submittedTrackingNumber = new Random().Next(10000, 99999).ToString();
            _submitted = true;
            Snackbar.Add("Application submitted successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            _submissionError = "An error occurred while submitting your application: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
