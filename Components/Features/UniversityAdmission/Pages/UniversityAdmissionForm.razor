@page "/Student/UniversityAdmission/Form"
@layout SaluExamPortal.Components.Shared.Layout.UniversityAdmissionLayout
@attribute [Authorize(Policy = "Student")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using SaluExamPortal.Domain.Enums
@using SaluExamPortal.Infrastructure.Persistence
@using SaluExamPortal.Application.UniversityAdmission.Models
@using SaluExamPortal.Application.UniversityAdmission.Services

@inject AdmissionFormService FormService
@inject SetupDataService SetupData
@inject UniversityAdmissionApplicationStore ApplicationStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>SALU – University Admission Form</PageTitle>

<div class="salu-admission-form-wrapper">
    <!-- STEPPER HEADER -->
    <div class="salu-stepper-container mb-4">
        <div class="salu-stepper">
            <div class="salu-step-item @(_currentStep == 1 ? "active" : "") @(FormService.State.PersonalDone ? "done" : "")"
                 @onclick="() => GoToStep(1)">
                <div class="step-num">
                    @if (FormService.State.PersonalDone) { <i class="bi bi-check-lg"></i> } else { <span>1</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Personal</span>
                    <span class="step-subtitle">Candidate Info</span>
                </div>
            </div>

            <div class="salu-step-item @(_currentStep == 2 ? "active" : "") @(FormService.State.AcademicsDone ? "done" : "")"
                 @onclick="() => GoToStep(2)">
                <div class="step-num">
                    @if (FormService.State.AcademicsDone) { <i class="bi bi-check-lg"></i> } else { <span>2</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Academics</span>
                    <span class="step-subtitle">Degree &amp; History</span>
                </div>
            </div>

            <div class="salu-step-item @(_currentStep == 3 ? "active" : "") @(FormService.State.PreferencesDone ? "done" : "")"
                 @onclick="() => GoToStep(3)">
                <div class="step-num">
                    @if (FormService.State.PreferencesDone) { <i class="bi bi-check-lg"></i> } else { <span>3</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Preferences</span>
                    <span class="step-subtitle">Backup Choices</span>
                </div>
            </div>

            <div class="salu-step-item @(_currentStep == 4 ? "active" : "") @(FormService.State.DocumentsDone ? "done" : "")"
                 @onclick="() => GoToStep(4)">
                <div class="step-num">
                    @if (FormService.State.DocumentsDone) { <i class="bi bi-check-lg"></i> } else { <span>4</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Documents</span>
                    <span class="step-subtitle">Upload Certificates</span>
                </div>
            </div>

            <div class="salu-step-item @(_currentStep == 5 ? "active" : "") @(FormService.State.UndertakingDone ? "done" : "")"
                 @onclick="() => GoToStep(5)">
                <div class="step-num">
                    @if (FormService.State.UndertakingDone) { <i class="bi bi-check-lg"></i> } else { <span>5</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Undertaking</span>
                    <span class="step-subtitle">Solemn Declaration</span>
                </div>
            </div>

            <div class="salu-step-item @(_currentStep == 6 ? "active" : "") @(FormService.State.AllMandatoryComplete ? "done" : "")"
                 @onclick="() => GoToStep(6)">
                <div class="step-num">
                    @if (_submitted) { <i class="bi bi-check-all"></i> } else { <span>6</span> }
                </div>
                <div class="step-text">
                    <span class="step-title">Status</span>
                    <span class="step-subtitle">Final Submission</span>
                </div>
            </div>
        </div>
    </div>

    @* =========================================================================
       STEP 1: PERSONAL INFORMATION
       ========================================================================= *@
    @if (_currentStep == 1)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">1. Personal Information</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Upload candidate photograph and enter complete biodata</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Step 1 of 6</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                <EditForm Model="FormService.State.Personal" OnValidSubmit="SavePersonal">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-2 small mb-4" />

                    <MudGrid Spacing="3">
                        @* ── LEFT SIDE: CANDIDATE PHOTO UPLOAD ── *@
                        <MudItem xs="12" md="4" lg="3">
                            <MudPaper Outlined="true" Class="pa-3 text-center rounded-lg bg-light d-flex flex-column align-center" Style="border: 1.5px dashed #cbd5e1;">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="color:#1b2a6b;">
                                    <i class="bi bi-camera-fill me-1"></i> Candidate Photograph <span class="text-danger">*</span>
                                </MudText>

                                <div class="salu-photo-frame mb-3">
                                    @if (!string.IsNullOrEmpty(FormService.State.Personal.PhotoUrl))
                                    {
                                        <img src="@FormService.State.Personal.PhotoUrl" alt="Candidate Photo" class="salu-photo-preview" />
                                    }
                                    else
                                    {
                                        <div class="salu-photo-placeholder">
                                            <i class="bi bi-person-bounding-box salu-placeholder-icon"></i>
                                            <span class="small text-muted mt-1">Passport Size Photo</span>
                                        </div>
                                    }
                                </div>

                                <InputFile id="candidatePhotoInput" OnChange="HandlePhotoSelected" accept=".jpg,.jpeg,.png" style="display:none;" />
                                <label for="candidatePhotoInput" class="btn-upload-photo mb-2">
                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Choose Photo
                                </label>

                                @if (!string.IsNullOrEmpty(FormService.State.Personal.PhotoUrl))
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="RemovePhoto" StartIcon="@Icons.Material.Filled.DeleteOutline" Class="mb-1">
                                        Remove Photo
                                    </MudButton>
                                }

                                @if (!string.IsNullOrEmpty(_photoError))
                                {
                                    <div class="text-danger small mt-1">@_photoError</div>
                                }

                                <div class="salu-photo-guidelines mt-2">
                                    <div class="guideline-item"><i class="bi bi-check-circle-fill text-success"></i> 3:4 passport ratio</div>
                                    <div class="guideline-item"><i class="bi bi-check-circle-fill text-success"></i> JPG or PNG, max 2MB</div>
                                    <div class="guideline-item"><i class="bi bi-check-circle-fill text-success"></i> White or light blue bg</div>
                                </div>
                            </MudPaper>
                        </MudItem>

                        @* ── RIGHT SIDE: 3-COLUMN BIODATA GRID ── *@
                        <MudItem xs="12" md="8" lg="9">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Full Name <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="FormService.State.Personal.Name" class="form-control form-control-sm" placeholder="Full legal name" />
                                    <ValidationMessage For="() => FormService.State.Personal.Name" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Father's Name <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="FormService.State.Personal.FatherName" class="form-control form-control-sm" placeholder="Father's full name" />
                                    <ValidationMessage For="() => FormService.State.Personal.FatherName" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Surname / Caste</label>
                                    <InputText @bind-Value="FormService.State.Personal.Surname" class="form-control form-control-sm" placeholder="e.g. Mahar, Shaikh, Syed" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Gender <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="FormService.State.Personal.Gender" class="form-select form-select-sm">
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">CNIC / B-Form <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="FormService.State.Personal.Cnic" data-mask="cnic" class="form-control form-control-sm" maxlength="15" placeholder="00000-0000000-0" />
                                    <ValidationMessage For="() => FormService.State.Personal.Cnic" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Date of Birth <span class="text-danger">*</span></label>
                                    <InputDate @bind-Value="FormService.State.Personal.DateOfBirth" class="form-control form-control-sm" />
                                    <ValidationMessage For="() => FormService.State.Personal.DateOfBirth" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Guardian's Name</label>
                                    <InputText @bind-Value="FormService.State.Personal.GuardianName" class="form-control form-control-sm" placeholder="Guardian if applicable" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Nationality <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="FormService.State.Personal.Nationality" class="form-select form-select-sm">
                                        @foreach (var nat in _nationalities)
                                        {
                                            <option value="@nat">@nat</option>
                                        }
                                    </InputSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Religion <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="FormService.State.Personal.Religion" class="form-select form-select-sm">
                                        <option value="Islam">Islam</option>
                                        <option value="Hinduism">Hinduism</option>
                                        <option value="Christianity">Christianity</option>
                                        <option value="Sikhism">Sikhism</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Domicile Province <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="FormService.State.Personal.DomicileProvince" class="form-select form-select-sm">
                                        @foreach (var prov in _provinces)
                                        {
                                            <option value="@prov">@prov</option>
                                        }
                                    </InputSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Domicile District <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="FormService.State.Personal.DomicileDistrict" class="form-select form-select-sm">
                                        @foreach (var dist in _districts)
                                        {
                                            <option value="@dist">@dist</option>
                                        }
                                    </InputSelect>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Tehsil / Taluka</label>
                                    <InputText @bind-Value="FormService.State.Personal.Tehsil" class="form-control form-control-sm" placeholder="e.g. Kot Diji, Kingri" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Mobile Number <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="FormService.State.Personal.MobileNo" data-mask="mobile" class="form-control form-control-sm" maxlength="12" placeholder="0300-0000000" />
                                    <ValidationMessage For="() => FormService.State.Personal.MobileNo" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Email Address <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="FormService.State.Personal.Email" class="form-control form-control-sm" placeholder="student@example.com" />
                                    <ValidationMessage For="() => FormService.State.Personal.Email" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <label class="form-label-small">Telephone / Residence No.</label>
                                    <InputText @bind-Value="FormService.State.Personal.ResidenceNumber" class="form-control form-control-sm" placeholder="Optional" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <label class="form-label-small">Current Residential Address <span class="text-danger">*</span></label>
                                    <InputTextArea @bind-Value="FormService.State.Personal.CurrentAddress" class="form-control form-control-sm" rows="2" placeholder="House/street, town, city" />
                                    <ValidationMessage For="() => FormService.State.Personal.CurrentAddress" class="text-danger small" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <label class="form-label-small">Permanent Address <span class="text-danger">*</span></label>
                                    <InputTextArea @bind-Value="FormService.State.Personal.PermanentAddress" class="form-control form-control-sm" rows="2" placeholder="Permanent address as on CNIC/Domicile" />
                                    <ValidationMessage For="() => FormService.State.Personal.PermanentAddress" class="text-danger small" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>

                        @* ── FACILITIES & QUOTA CHECKBOXES ── *@
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="color:#1b2a6b;">
                                <i class="bi bi-gear-wide-connected me-1"></i> Special Quotas &amp; University Facilities
                            </MudText>
                            <div class="salu-options-bar">
                                <label class="salu-switch-box">
                                    <InputCheckbox @bind-Value="FormService.State.Personal.AvailHostel" />
                                    <span>Hostel Accommodation</span>
                                </label>
                                <label class="salu-switch-box">
                                    <InputCheckbox @bind-Value="FormService.State.Personal.AvailTransport" />
                                    <span>Point / Transport Service</span>
                                </label>
                                <label class="salu-switch-box">
                                    <InputCheckbox @bind-Value="FormService.State.Personal.FirstFamilyMember" />
                                    <span>First Family Member in University</span>
                                </label>
                                <label class="salu-switch-box">
                                    <InputCheckbox @bind-Value="FormService.State.Personal.SelfFinance" />
                                    <span>Self-Finance Candidate</span>
                                </label>
                                <label class="salu-switch-box">
                                    <InputCheckbox @bind-Value="FormService.State.Personal.IsEmployed" />
                                    <span>Currently Employed</span>
                                </label>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex justify-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn-salu-next">
                            <span>Save &amp; Continue to Academics</span>
                            <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }

    @* =========================================================================
       STEP 2: ACADEMIC PROGRAM & QUALIFICATION HISTORY
       ========================================================================= *@
    @if (_currentStep == 2)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">2. Academic Program &amp; Educational History</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Select program of study and add all educational degrees</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Step 2 of 6</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                @* ── PROGRAM SELECTION ── *@
                <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4 bg-light">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color:#1b2a6b;">
                        <i class="bi bi-mortarboard-fill me-1 text-warning"></i> Choose Program of Study <span class="text-danger">*</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Faculty <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_faculty" @bind:after="OnFacultyChanged">
                                <option value="">Select Faculty</option>
                                @foreach (var f in SetupDataService.Faculties)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Department <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_dept" @bind:after="OnDeptChanged" disabled="@(!_depts.Any())">
                                <option value="">Select Department</option>
                                @foreach (var d in _depts)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Program <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_program" @bind:after="OnProgramChanged" disabled="@(!_programs.Any())">
                                <option value="">Select Program</option>
                                @foreach (var p in _programs)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrEmpty(FormService.State.Academics.QualifyingDegree))
                    {
                        <div class="salu-qualifying-badge mt-3">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <span>Required Qualifying Degree: <strong>@FormService.State.Academics.QualifyingDegree</strong></span>
                            @if (!string.IsNullOrEmpty(FormService.State.Academics.EligibleMajor))
                            {
                                <span class="ms-3">Major: <strong>@FormService.State.Academics.EligibleMajor</strong></span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="text-danger small mt-2">@_error</div>
                    }
                </MudPaper>

                @* ── ADD QUALIFICATION RECORD ── *@
                <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color:#1b2a6b;">
                        <i class="bi bi-plus-circle-fill me-1 text-success"></i> Add Educational Qualification
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <label class="form-label-small">Examination Level <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_row.Examination">
                                <option value="">Select Examination</option>
                                @foreach (var e in _examinations)
                                {
                                    <option value="@e.Name">@e.Name</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <label class="form-label-small">Group / Major <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="_row.GroupMajor" placeholder="e.g. Pre-Engineering, ICS" />
                        </MudItem>

                        <MudItem xs="6" sm="4" md="2">
                            <label class="form-label-small">Passing Year <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_row.Year">
                                <option value="">Year</option>
                                @foreach (var y in _acadYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="6" sm="4" md="2">
                            <label class="form-label-small">Seat / Roll No. <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="_row.SeatNo" placeholder="Seat number" />
                        </MudItem>

                        <MudItem xs="6" sm="4" md="2">
                            <label class="form-label-small">Obtained Marks <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="number" @bind="_row.ObtainedMarks" placeholder="e.g. 845" />
                        </MudItem>

                        <MudItem xs="6" sm="4" md="2">
                            <label class="form-label-small">Total Marks <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="number" @bind="_row.TotalMarks" placeholder="e.g. 1100" />
                        </MudItem>

                        <MudItem xs="12" sm="8" md="5">
                            <label class="form-label-small">Board / University <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_row.Board">
                                <option value="">Select Board / University</option>
                                @foreach (var b in _boards)
                                {
                                    <option value="@b.Name">@b.Name</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" sm="12" md="5">
                            <label class="form-label-small">Institute / College / School <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="_row.Institute" placeholder="College / School name" />
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AddAcademicRecord" style="background:#1b2a6b; border:none; padding:7px 18px; font-weight:600;">
                                <i class="bi bi-plus-lg me-1"></i> Add Record to Table
                            </button>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @* ── QUALIFICATIONS TABLE ── *@
                <div class="table-responsive border rounded-lg mb-4">
                    <table class="table table-hover table-striped mb-0 small">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Examination</th>
                                <th>Group/Major</th>
                                <th>Year</th>
                                <th>Seat No</th>
                                <th>Obtained</th>
                                <th>Total</th>
                                <th>Percentage</th>
                                <th>Board/University</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FormService.State.Academics.History.Any())
                            {
                                int idx = 1;
                                @foreach (var rec in FormService.State.Academics.History)
                                {
                                    double pct = 0;
                                    if (double.TryParse(rec.ObtainedMarks, out var ob) && double.TryParse(rec.TotalMarks, out var tot) && tot > 0)
                                    {
                                        pct = Math.Round((ob / tot) * 100, 2);
                                    }
                                    <tr>
                                        <td>@(idx++)</td>
                                        <td><strong>@rec.Examination</strong></td>
                                        <td>@rec.GroupMajor</td>
                                        <td>@rec.Year</td>
                                        <td>@rec.SeatNo</td>
                                        <td>@rec.ObtainedMarks</td>
                                        <td>@rec.TotalMarks</td>
                                        <td><span class="badge bg-success">@pct %</span></td>
                                        <td>@rec.Board</td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => RemoveAcademicRecord(rec)" title="Delete record">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-3">
                                        <em>No qualification records added yet. Please use the form above to add your academic degrees (SSC, HSC, etc.).</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-space-between mt-4 pt-3 border-top">
                    <button type="button" class="btn-salu-back" @onclick="() => GoToStep(1)">
                        <i class="bi bi-arrow-left me-1"></i> Back to Personal
                    </button>
                    <button type="button" class="btn-salu-next" @onclick="SaveAcademics">
                        <span>Save &amp; Continue to Preferences</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* =========================================================================
       STEP 3: PROGRAM PREFERENCES
       ========================================================================= *@
    @if (_currentStep == 3)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">3. Program Preferences</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Select backup/alternative choices in order of preference (Optional)</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Step 3 of 6</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4 bg-light">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color:#1b2a6b;">
                        <i class="bi bi-list-ol me-1 text-warning"></i> Add Program Choice
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Faculty</label>
                            <select class="form-select form-select-sm" @bind="_fac" @bind:after="OnPrefFacultyChanged">
                                <option value="">Select Faculty</option>
                                @foreach (var f in SetupDataService.Faculties)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Department</label>
                            <select class="form-select form-select-sm" @bind="_prefDept" @bind:after="OnPrefDeptChanged" disabled="@(!_prefDepts.Any())">
                                <option value="">Select Department</option>
                                @foreach (var d in _prefDepts)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Program Choice</label>
                            <select class="form-select form-select-sm" @bind="_prog" disabled="@(!_prefPrograms.Any())">
                                <option value="">Select Program</option>
                                @foreach (var p in _prefPrograms)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AddPreference" style="background:#1b2a6b; border:none; padding:7px 18px; font-weight:600;">
                                <i class="bi bi-plus-lg me-1"></i> Add Choice to List
                            </button>
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrEmpty(_errPref))
                    {
                        <div class="text-danger small mt-2">@_errPref</div>
                    }
                </MudPaper>

                <div class="table-responsive border rounded-lg mb-4">
                    <table class="table table-hover mb-0 small">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:80px;">Priority</th>
                                <th>Faculty</th>
                                <th>Department</th>
                                <th>Program</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FormService.State.Preferences.Any())
                            {
                                int pIdx = 1;
                                @foreach (var pref in FormService.State.Preferences)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary">Choice @(pIdx++)</span></td>
                                        <td>@pref.Faculty</td>
                                        <td>@pref.Department</td>
                                        <td><strong>@pref.Program</strong></td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => RemovePreference(pref)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        <em>No preferences added. Your primary degree selected in Step 2 will be your primary admission choice.</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-space-between mt-4 pt-3 border-top">
                    <button type="button" class="btn-salu-back" @onclick="() => GoToStep(2)">
                        <i class="bi bi-arrow-left me-1"></i> Back to Academics
                    </button>
                    <button type="button" class="btn-salu-next" @onclick="SavePreferences">
                        <span>Save &amp; Continue to Documents</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* =========================================================================
       STEP 4: DOCUMENTS UPLOAD
       ========================================================================= *@
    @if (_currentStep == 4)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">4. Upload Documents</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Upload scanned copies of required educational certificates and identification</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Step 4 of 6</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4 bg-light">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color:#1b2a6b;">
                        <i class="bi bi-file-earmark-arrow-up-fill me-1 text-primary"></i> Upload Required Document
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Document Type <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="_type">
                                <option value="">Select Document Type</option>
                                @foreach (var dt in _docTypes)
                                {
                                    <option value="@dt.Name">@dt.Name</option>
                                }
                            </select>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Document Title / Remarks <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" @bind="_name" placeholder="e.g. Matric Certificate, Inter Marksheet" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <label class="form-label-small">Choose File (JPG, PNG, PDF) <span class="text-danger">*</span></label>
                            <InputFile class="form-control form-control-sm" OnChange="HandleDocFileSelected" accept=".jpg,.jpeg,.png,.pdf" />
                            @if (!string.IsNullOrEmpty(_fileName))
                            {
                                <span class="text-success small"><i class="bi bi-check-circle"></i> @_fileName</span>
                            }
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AddDocument" style="background:#1b2a6b; border:none; padding:7px 18px; font-weight:600;">
                                <i class="bi bi-cloud-upload-fill me-1"></i> Add Document
                            </button>
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrEmpty(_errDoc))
                    {
                        <div class="text-danger small mt-2">@_errDoc</div>
                    }
                </MudPaper>

                <div class="table-responsive border rounded-lg mb-4">
                    <table class="table table-hover mb-0 small">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>Document Type</th>
                                <th>Document Title</th>
                                <th>File Name</th>
                                <th>Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FormService.State.Documents.Any())
                            {
                                int dIdx = 1;
                                @foreach (var doc in FormService.State.Documents)
                                {
                                    <tr>
                                        <td>@(dIdx++)</td>
                                        <td><span class="badge bg-secondary">@doc.DocType</span></td>
                                        <td><strong>@doc.DocName</strong></td>
                                        <td><code>@doc.FileName</code></td>
                                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Attached</span></td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" @onclick="() => RemoveDocument(doc)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">
                                        <em>No documents uploaded yet. Please upload Matric Marksheet, Intermediate Certificate, CNIC copy, etc.</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-space-between mt-4 pt-3 border-top">
                    <button type="button" class="btn-salu-back" @onclick="() => GoToStep(3)">
                        <i class="bi bi-arrow-left me-1"></i> Back to Preferences
                    </button>
                    <button type="button" class="btn-salu-next" @onclick="SaveDocuments">
                        <span>Save &amp; Continue to Undertaking</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* =========================================================================
       STEP 5: UNDERTAKING & DECLARATION
       ========================================================================= *@
    @if (_currentStep == 5)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">5. Solemn Declaration &amp; Undertaking</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Please review and accept the official undertaking before submitting</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Step 5 of 6</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                <div class="salu-undertaking-box mb-4">
                    <div class="salu-undertaking-header">
                        <i class="bi bi-shield-fill-check text-warning fs-4 me-2"></i>
                        <span class="fw-bold">SHAH ABDUL LATIF UNIVERSITY KHAIRPUR – CANDIDATE DECLARATION</span>
                    </div>

                    <div class="salu-undertaking-body">
                        <p>1. <strong>I hereby undertake</strong> that the entries made by me in this admission form are correct and complete to the best of my knowledge and belief.</p>
                        <p>2. I understand that my admission to Shah Abdul Latif University (SALU) is purely provisional and subject to cancellation if any irregularity, false document, or misstatement is detected at any stage of my academic tenure.</p>
                        <p>3. I solemnly declare that I am not currently registered/enrolled as a regular student for any degree program in any other University, Degree Awarding Institute, or Affiliated College.</p>
                        <p>4. I solemnly promise to abide by all the rules, discipline, code of conduct, and regulations of Shah Abdul Latif University as enforced from time to time.</p>
                    </div>

                    <div class="salu-undertaking-checkbox mt-3">
                        <label class="d-flex align-items-center gap-2 cursor-pointer">
                            <InputCheckbox @bind-Value="FormService.State.UndertakingAccepted" style="width:20px; height:20px; accent-color:#f97316;" />
                            <span class="fw-bold text-dark">I solemnly agree, confirm, and accept the above declaration and undertaking.</span>
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errUndertaking))
                {
                    <div class="alert alert-danger py-2 small mb-3">@_errUndertaking</div>
                }

                <div class="d-flex justify-space-between mt-4 pt-3 border-top">
                    <button type="button" class="btn-salu-back" @onclick="() => GoToStep(4)">
                        <i class="bi bi-arrow-left me-1"></i> Back to Documents
                    </button>
                    <button type="button" class="btn-salu-next" @onclick="SaveUndertaking">
                        <span>Accept &amp; Proceed to Final Step</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* =========================================================================
       STEP 6: STATUS & FINAL SUBMISSION
       ========================================================================= *@
    @if (_currentStep == 6)
    {
        <MudCard Elevation="2" Class="rounded-lg mb-4">
            <MudCardHeader Class="salu-card-header">
                <CardHeaderContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold text-white">6. Application Status &amp; Final Submission</MudText>
                            <MudText Typo="Typo.caption" Class="text-white-50">Review mandatory requirements checklist and submit your admission form</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Final Step</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-4 pa-md-6">
                @if (!_submitted)
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color:#1b2a6b;">
                        Application Readiness Checklist:
                    </MudText>

                    <MudGrid Spacing="2" Class="mb-4">
                        <MudItem xs="12" sm="6" md="4">
                            <div class="salu-status-card @(FormService.State.PersonalDone ? "status-done" : "status-pending")">
                                <div class="status-icon"><i class="bi @(FormService.State.PersonalDone ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i></div>
                                <div>
                                    <div class="status-title">Personal Information</div>
                                    <div class="status-state">@(FormService.State.PersonalDone ? "Complete" : "Incomplete")</div>
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <div class="salu-status-card @(FormService.State.AcademicsDone ? "status-done" : "status-pending")">
                                <div class="status-icon"><i class="bi @(FormService.State.AcademicsDone ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i></div>
                                <div>
                                    <div class="status-title">Academic Qualifications</div>
                                    <div class="status-state">@(FormService.State.AcademicsDone ? "Complete" : "Incomplete")</div>
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <div class="salu-status-card @(FormService.State.DocumentsDone ? "status-done" : "status-pending")">
                                <div class="status-icon"><i class="bi @(FormService.State.DocumentsDone ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i></div>
                                <div>
                                    <div class="status-title">Uploaded Documents</div>
                                    <div class="status-state">@(FormService.State.DocumentsDone ? "Complete" : "Incomplete")</div>
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <div class="salu-status-card @(FormService.State.UndertakingDone ? "status-done" : "status-pending")">
                                <div class="status-icon"><i class="bi @(FormService.State.UndertakingDone ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i></div>
                                <div>
                                    <div class="status-title">Undertaking Declaration</div>
                                    <div class="status-state">@(FormService.State.UndertakingDone ? "Accepted" : "Not Accepted")</div>
                                </div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <div class="salu-status-card @(FormService.State.PreferencesDone ? "status-done" : "status-optional")">
                                <div class="status-icon"><i class="bi bi-info-circle-fill text-primary"></i></div>
                                <div>
                                    <div class="status-title">Program Preferences</div>
                                    <div class="status-state">@(FormService.State.PreferencesDone ? "Provided" : "Optional")</div>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    @if (FormService.State.AllMandatoryComplete)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-3 p-3 rounded-lg mb-4">
                            <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                            <div>
                                <div class="fw-bold">All mandatory requirements are fulfilled!</div>
                                <div class="small">Click the submit button below to finalize your admission application.</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_submissionError))
                        {
                            <div class="alert alert-danger py-2 small mb-3">@_submissionError</div>
                        }

                        <div class="d-flex justify-space-between mt-4 pt-3 border-top">
                            <button type="button" class="btn-salu-back" @onclick="() => GoToStep(5)">
                                <i class="bi bi-arrow-left me-1"></i> Back to Undertaking
                            </button>
                            <button type="button" class="btn-salu-submit" @onclick="SubmitForm" disabled="@_isSubmitting">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Submitting Application...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-check-fill me-2"></i>
                                    <span>Final Submit Application</span>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning p-3 rounded-lg mb-4">
                            <div class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> Some mandatory sections are incomplete!</div>
                            <div class="small mt-1">Please use the stepper above to complete all mandatory sections (Personal Info, Academics, Documents, and Undertaking) before submitting.</div>
                        </div>

                        <div class="d-flex justify-start mt-4 pt-3 border-top">
                            <button type="button" class="btn-salu-back" @onclick="() => GoToStep(1)">
                                <i class="bi bi-arrow-left me-1"></i> Review Incomplete Steps
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="salu-success-card text-center py-5">
                        <div class="salu-success-check mb-3">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-2">Application Submitted Successfully!</h3>
                        <p class="text-muted mb-4">Your regular admission application has been received by Shah Abdul Latif University.</p>

                        <div class="salu-tracking-badge d-inline-block px-4 py-2 rounded-pill mb-3" style="background:#e0f2fe; border:1px solid #7dd3fc;">
                            <span class="text-muted small">Tracking ID: </span>
                            <strong class="text-primary fs-5">SALU-2026-@_submittedTrackingNumber</strong>
                        </div>

                        <!-- QR Code Preview -->
                        <div class="mb-4">
                            <img src="/api/university-admission/qr-code?code=SALU-2026-@_submittedTrackingNumber" alt="Verification QR Code" style="width:110px; height:110px; border:1px solid #cbd5e1; border-radius:8px; padding:4px; background:#fff; box-shadow: 0 2px 8px rgba(0,0,0,0.06);" />
                            <div class="text-muted small mt-1">Official Verification QR Code</div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="/api/university-admission/download-form/SALU-2026-@_submittedTrackingNumber" target="_blank" class="btn btn-danger d-inline-flex align-items-center" style="background:#dc2626; border:none; padding:10px 22px; font-weight:600; border-radius:8px;">
                                <i class="bi bi-file-earmark-pdf-fill me-2 fs-5"></i> Download Form (PDF)
                            </a>
                            <a href="/api/university-admission/download-challan/SALU-2026-@_submittedTrackingNumber" target="_blank" class="btn btn-success d-inline-flex align-items-center" style="background:#16a34a; border:none; padding:10px 22px; font-weight:600; border-radius:8px;">
                                <i class="bi bi-receipt me-2 fs-5"></i> Download Fee Challan
                            </a>
                            <a href="Student/candidate-status" class="btn btn-primary d-inline-flex align-items-center" style="background:#1b2a6b; border:none; padding:10px 22px; font-weight:600; border-radius:8px;">
                                <i class="bi bi-eye-fill me-2"></i> View Status
                            </a>
                        </div>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    /* =========================================================================
       SALU UNIVERSITY ADMISSION FORM - MODERN STYLES
       ========================================================================= */
    .salu-admission-form-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 8px 4px 32px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* STEPPER */
    .salu-stepper-container {
        overflow-x: auto;
        padding-bottom: 4px;
    }
    .salu-stepper {
        display: flex;
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        min-width: 720px;
    }
    .salu-step-item {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-right: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        user-select: none;
    }
    .salu-step-item:last-child { border-right: none; }
    .salu-step-item:hover:not(.active) { background: #f8fafc; }
    .salu-step-item.active {
        background: linear-gradient(135deg, #1b2a6b 0%, #254c88 100%);
        color: #ffffff;
    }
    .salu-step-item.active .step-subtitle { color: #cbd5e1 !important; }
    .salu-step-item.active .step-num {
        background: #f97316;
        color: #ffffff;
    }
    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        flex-shrink: 0;
    }
    .salu-step-item.done .step-num {
        background: #22c55e;
        color: #ffffff;
    }
