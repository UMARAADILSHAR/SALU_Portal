@page "/Student/UniversityAdmission"
@page "/Student/UniversityAdmission/{ViewName}"
@attribute [Authorize(Policy = "Student")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using SaluExamPortal.Domain.Enums
@using SaluExamPortal.Infrastructure.Persistence

<HeadContent>
    <link rel="stylesheet" href="university-admission/university-admission.css" />
</HeadContent>
@implements IDisposable
@inject NavigationManager Nav
@inject SetupDataService SetupData
@inject AdmissionFormService FormService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>SALU – PG Admission Portal</PageTitle>

<!-- TOP HEADER -->
<header class="top-header">
    <div class="header-left">
        <div class="salu-logo">SALU</div>
        <button class="nav-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">☰</button>
        <span class="header-title-text">PG Admissions Portal</span>
    </div>
    <div class="header-right">
        <div class="user-badge" title="@StudentEmail">
            <div class="user-avatar">
                @StudentInitials
                <span class="user-status-dot"></span>
            </div>
            <span class="user-name">@StudentName</span>
        </div>
        <form action="Account/Logout" method="post" style="display:inline; margin-left: 8px;">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="" />
            <button type="submit" class="nav-toggle-btn" title="Sign Out" style="font-size:0.82rem; padding:4px 8px; border-radius:4px; display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                <i class="bi bi-box-arrow-right"></i>
                <span style="font-size:0.75rem;">Logout</span>
            </button>
        </form>
    </div>
</header>

<!-- LAYOUT -->
<div class="portal-layout">

    <!-- PRIMARY NAV STRIP (NAVY) -->
    <div class="sidebar-strip">
        <div class="module-btn" @onclick='() => SetView("eligibility-prgm")' title="SALU PG Admissions">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16" />
                <circle cx="9" cy="6" r="2" fill="currentColor"/>
                <circle cx="15" cy="12" r="2" fill="currentColor"/>
                <circle cx="7" cy="18" r="2" fill="currentColor"/>
            </svg>
            <span>PG -<br>ADMISSION</span>
            <span class="arrow">&#9654;</span>
        </div>
    </div>

    <!-- SECONDARY SUBMENU -->
    <div class="sidebar-submenu @(_sidebarOpen ? "" : "collapsed")">
        <ul class="submenu-list">
            @foreach (var item in _menuItems)
            {
                var isItemActive = _activeView == item.ViewId;
                <li>
                    <NavLink href="@item.ViewId"
                             class="@($"submenu-item {(isItemActive ? "active" : "")}")"
                             @onclick="() => SetView(item.ViewId)">
                        @((MarkupString)item.Icon)
                        <span>@item.Label</span>
                    </NavLink>
                </li>
            }
        </ul>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <div class="main-inner">

            <!-- WELCOME BANNER -->
            <div class="salu-welcome-banner">
                <div class="name">Welcome, @StudentName</div>
                <div class="date">@DateTime.Now.ToString("dddd dd MMMM yyyy")</div>
            </div>

            <!-- VIEWS -->
            @switch (_activeView)
            {
                case "eligibility-prgm":
                    <EligibilityProgramView OnApplyForProgram="GoToAcademicsStep" />
                    break;
                case "instructions":
                    <InstructionsView />
                    break;
                case "submit-app":
                    <SubmitApplicationView />
                    break;
                case "candidate-status":
                    <CandidateStatusView />
                    break;
                case "checklist":
                    <ChecklistView />
                    break;
                case "admission-schedule":
                    <AdmissionScheduleView />
                    break;
                case "sample-papers":
                    <SamplePapersView />
                    break;
                case "prospectus":
                    <ProspectusView />
                    break;
                case "eligibility-general":
                    <EligibilityGeneralView />
                    break;
                case "admission-procedure":
                    <AdmissionProcedureView />
                    break;
                case "fee-structure":
                    <FeeStructureView />
                    break;
                default:
                    <EligibilityProgramView OnApplyForProgram="GoToAcademicsStep" />
                    break;
            }
        </div>
    </div>
</div>

<footer class="footer">
    Copyright &copy; @DateTime.Now.Year Shah Abdul Latif University. All Rights Reserved.
</footer>

@code {
    [Parameter] public string? ViewName { get; set; }

    private string _activeView = "eligibility-prgm";
    private bool _sidebarOpen = true;
    private ApplicationUser? _currentUser;

    private string StudentName => string.IsNullOrWhiteSpace(_currentUser?.FullName)
        ? (_currentUser?.UserName ?? "Student")
        : _currentUser.FullName;

    private string StudentEmail => _currentUser?.Email ?? "";

    private string StudentInitials
    {
        get
        {
            var name = StudentName.Trim();
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0) return "S";
            if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null || user.AdmissionType != AdmissionType.UniversityRegular)
        {
            Nav.NavigateTo("Student", replace: true);
            return;
        }

        _currentUser = user;
        UpdateActiveViewFromUrl();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        UpdateActiveViewFromUrl();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveViewFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateActiveViewFromUrl()
    {
        if (!string.IsNullOrWhiteSpace(ViewName))
        {
            _activeView = ViewName.ToLowerInvariant();
            return;
        }

        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        if (string.IsNullOrEmpty(relative) ||
            relative.Equals("Student/UniversityAdmission", StringComparison.OrdinalIgnoreCase))
        {
            _activeView = "eligibility-prgm";
        }
        else
        {
            const string routePrefix = "Student/UniversityAdmission/";
            if (relative.StartsWith(routePrefix, StringComparison.OrdinalIgnoreCase))
            {
                relative = relative[routePrefix.Length..].Trim('/');
            }
            _activeView = string.IsNullOrEmpty(relative) ? "eligibility-prgm" : relative.ToLowerInvariant();
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void SetView(string viewId)
    {
        _activeView = viewId;
        if (!Nav.Uri.EndsWith("/" + viewId, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"Student/UniversityAdmission/{viewId}");
        }
    }

    private void GoToAcademicsStep()
    {
        SetView("submit-app");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private record MenuItem(string ViewId, string Label, string Icon);

    private readonly List<MenuItem> _menuItems =
    [
        new("instructions",        "Instructions",               """<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>"""),
        new("submit-app",          "Submit Application",         """<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>"""),
        new("eligibility-prgm",    "Eligibility Criteria-Prgm.", """<svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect><path d="M9 14l2 2 4-4"></path></svg>"""),
        new("candidate-status",    "Candidate Status",           """<svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>"""),
        new("checklist",           "Checklist",                  """<svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>"""),
        new("admission-schedule",  "Admission Schedule",         """<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>"""),
        new("sample-papers",       "Sample Papers",              """<svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>"""),
        new("prospectus",          "Prospectus",                 """<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>"""),
        new("eligibility-general", "Eligibility Criteria-General","""<svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>"""),
        new("admission-procedure", "Admission Procedure",        """<svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="12"></line><line x1="15" y1="12" x2="15" y2="22"></line><line x1="4" y1="12" x2="20" y2="12"></line></svg>"""),
        new("fee-structure",       "Fee Structure",              """<svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>"""),
    ];
}

