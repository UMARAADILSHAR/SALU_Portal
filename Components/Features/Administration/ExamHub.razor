@page "/Administration/Exams"
@attribute [Authorize(Policy = "UniversityAdministration")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SaluExamPortal.Domain.Entities
@using EntityEnrollment = SaluExamPortal.Domain.Entities.Enrollment
@using SaluExamPortal.Domain.Enums
@using SaluExamPortal.Domain.Models
@using SaluExamPortal.Infrastructure.Persistence
@using SaluExamPortal.Application.Services
@using MudBlazor
@inject ApplicationDbContext Db
@inject ISystemConfigurationService ConfigService
@inject ICollegeScopingService ScopingService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Exam Hub – SALU Controller of Examinations</PageTitle>

<div class="salu-admin-wrapper">
    <!-- HERO HEADER -->
    <div class="salu-hero-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="salu-hero-crest-holder">
                    <img src="images/salu-logo.png" alt="SALU Crest" class="salu-hero-crest" />
                </div>
                <div>
                    <div class="salu-hero-pill">
                        <span class="salu-pulse-dot"></span>
                        <span>CONTROLLER OF EXAMINATIONS • EXAM COMMAND</span>
                    </div>
                    <h2 class="salu-hero-heading">EXAMINATION HUB</h2>
                    <p class="salu-hero-subheading">Anti-Skip Gatekeeper • Bulk QR Admit Cards • Seating Allocations • Examination Centers</p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <MudChip T="string" Color="@(examinationSettings.IsExamRegistrationOpen ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Medium" Class="fw-bold px-3">
                    @(examinationSettings.IsExamRegistrationOpen ? "EXAM PORTAL ACTIVE" : "EXAM REGISTRATION CLOSED")
                </MudChip>

                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Info" 
                           StartIcon="@Icons.Material.Filled.Shield" 
                           OnClick="RunAntiSkipAuditAsync" 
                           Class="fw-bold bg-white">
                    Run Anti-Skip Audit
                </MudButton>
            </div>
        </div>
    </div>

    <!-- EXAM METRICS -->
    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="salu-kpi-mudcard kpi-purple-border">
                <MudCardContent Class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="salu-kpi-sub">ISSUED ADMIT CARDS</div>
                            <div class="salu-kpi-val text-primary font-monospace">@issuedAdmitCards.Count</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Secondary" Size="Size.Large" />
                    </div>
                    <div class="salu-kpi-foot">Cryptographic QR Verifiable</div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="salu-kpi-mudcard kpi-success-border">
                <MudCardContent Class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="salu-kpi-sub">ELIGIBLE PAID CANDIDATES</div>
                            <div class="salu-kpi-val text-success">@eligibleCandidatesCount</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <div class="salu-kpi-foot">Approved + Verified Fee</div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="salu-kpi-mudcard kpi-blue-border">
                <MudCardContent Class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="salu-kpi-sub">EXAM CENTERS ACTIVE</div>
                            <div class="salu-kpi-val">12</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Primary" Size="Size.Large" />
                    </div>
                    <div class="salu-kpi-foot">Main Campus &amp; Affiliated Hubs</div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="salu-kpi-mudcard kpi-emerald-border">
                <MudCardContent Class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="salu-kpi-sub">ANTI-SKIP INTEGRITY</div>
                            <div class="salu-kpi-val text-success">100%</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <div class="salu-kpi-foot">Zero Unpaid Leaks</div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <!-- BULK ADMIT CARD GENERATOR -->
        <MudItem xs="12" lg="4">
            <MudCard Elevation="2" Class="h-100 d-flex flex-column">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="fw-bold text-navy">Bulk QR Admit Card Engine</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Issue official examination slips with QR verification</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="d-flex flex-column gap-3 flex-grow-1">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        <strong>Anti-Skip Policy:</strong> Only students with <strong>Approved</strong> enrollment status and <strong>Paid</strong> fee challans are eligible.
                    </MudAlert>

                    <MudSelect T="string" @bind-Value="selectedExamSession" Label="Examination Session" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("ANNUAL EXAMINATIONS 2026")">ANNUAL EXAMINATIONS 2026</MudSelectItem>
                        <MudSelectItem Value="@("SUPPLEMENTARY EXAMINATIONS 2026")">SUPPLEMENTARY EXAMINATIONS 2026</MudSelectItem>
                        <MudSelectItem Value="@("SEMESTER FINAL EXAMINATIONS 2026")">SEMESTER FINAL EXAMINATIONS 2026</MudSelectItem>
                    </MudSelect>

                    <MudTextField Value="@defaultExamCenter" Label="Default Examination Center" Variant="Variant.Outlined" ReadOnly="true" />

                    <div class="p-3 bg-light rounded small">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Pending Admit Cards:</span>
                            <strong class="text-primary">@pendingAdmitCardsCount candidates</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Admit Card Fee Clearance:</span>
                            <strong class="text-success">Verified Paid</strong>
                        </div>
                    </div>

                    <div class="mt-auto pt-3">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   FullWidth="true" 
                                   Size="Size.Large" 
                                   StartIcon="@Icons.Material.Filled.Bolt" 
                                   OnClick="BulkGenerateAdmitCardsAsync" 
                                   Class="fw-bold">
                            Generate &amp; Issue Admit Cards
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ISSUED ADMIT CARDS MASTER LEDGER -->
        <MudItem xs="12" lg="8">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 w-100">
                            <div>
                                <MudText Typo="Typo.h6" Class="fw-bold text-navy">Issued Admit Cards Ledger (@issuedAdmitCards.Count)</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">Master examination seating &amp; cryptographic QR registry</MudText>
                            </div>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    <MudTable Items="@issuedAdmitCards" Hover="true" Elevation="0" Dense="true">
                        <HeaderContent>
                            <MudTh>Roll Number</MudTh>
                            <MudTh>Center</MudTh>
                            <MudTh>Room / Seat</MudTh>
                            <MudTh>Exam Date</MudTh>
                            <MudTh>QR Verification Hash</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="font-monospace fw-bold text-primary">@context.RollNumber</MudTd>
                            <MudTd>@context.ExamCenter</MudTd>
                            <MudTd>Room @context.RoomNumber / Seat @context.SeatNumber</MudTd>
                            <MudTd>@context.ExamDate.ToString("dd MMM yyyy")</MudTd>
                            <MudTd>
                                <span class="badge bg-success font-monospace" title="@context.QRVerificationHash">VERIFIED QR</span>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

<style>
    .salu-admin-wrapper { padding: 24px; background-color: #f1f5f9; min-height: 100vh; font-family: 'Inter', system-ui, sans-serif; }
    .salu-hero-header { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); color: white; padding: 24px 32px; border-radius: 12px; }
    .salu-hero-crest-holder { width: 56px; height: 56px; background: white; border-radius: 8px; padding: 3px; display: flex; align-items: center; justify-content: center; }
    .salu-hero-crest { width: 100%; height: 100%; object-fit: contain; }
    .salu-hero-pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); padding: 3px 10px; border-radius: 20px; font-size: 0.68rem; font-weight: 700; }
    .salu-pulse-dot { width: 7px; height: 7px; background: #22c55e; border-radius: 50%; }
    .salu-hero-heading { font-size: 1.4rem; font-weight: 800; margin: 0; }
    .salu-hero-subheading { font-size: 0.8rem; color: #cbd5e1; margin: 2px 0 0 0; }
    .salu-kpi-mudcard { border-radius: 10px; border-left: 4px solid; }
    .kpi-purple-border { border-left-color: #8b5cf6; }
    .kpi-success-border { border-left-color: #10b981; }
    .kpi-blue-border { border-left-color: #2563eb; }
    .kpi-emerald-border { border-left-color: #059669; }
    .salu-kpi-sub { font-size: 0.65rem; font-weight: 800; color: #64748b; }
    .salu-kpi-val { font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-top: 2px; }
    .salu-kpi-foot { font-size: 0.68rem; color: #94a3b8; margin-top: 8px; }
</style>

@code {
    private List<AdmitCard> issuedAdmitCards = [];
    private List<EntityEnrollment> eligibleCandidates = [];
    private int eligibleCandidatesCount;
    private int pendingAdmitCardsCount;

    private string selectedExamSession = "ANNUAL EXAMINATIONS 2026";
    private string defaultExamCenter = "MAIN AUDITORIUM, SALU KHAIRPUR";

    private ExaminationSettings examinationSettings = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        examinationSettings = await ConfigService.GetExaminationSettingsAsync();

        issuedAdmitCards = await Db.AdmitCards
            .Include(a => a.Enrollment)
            .OrderByDescending(a => a.IssuedAt)
            .ToListAsync();

        var approvedPaidCandidates = await Db.Enrollments
            .Include(e => e.Fees)
            .Include(e => e.AdmitCard)
            .Where(e => e.Status == EnrollmentStatus.Approved && e.Fees.Any(f => f.Status == FeeStatus.Verified))
            .ToListAsync();

        eligibleCandidatesCount = approvedPaidCandidates.Count;
        pendingAdmitCardsCount = approvedPaidCandidates.Count(e => e.AdmitCard == null);
    }

    private async Task BulkGenerateAdmitCardsAsync()
    {
        var candidatesAwaiting = await Db.Enrollments
            .Include(e => e.Fees)
            .Include(e => e.AdmitCard)
            .Where(e => e.Status == EnrollmentStatus.Approved && e.Fees.Any(f => f.Status == FeeStatus.Verified) && e.AdmitCard == null)
            .ToListAsync();

        if (candidatesAwaiting.Count == 0)
        {
            Snackbar.Add("No approved + paid candidates awaiting admit cards.", Severity.Info);
            return;
        }

        int count = 0;
        int seatStart = 101;

        foreach (var app in candidatesAwaiting)
        {
            var card = new AdmitCard
            {
                EnrollmentId = app.Id,
                RollNumber = app.RollNumber ?? $"SALU-26-{new Random().Next(10000, 99999)}",
                ExamCenter = defaultExamCenter,
                CenterCode = "SALU-AUD-01",
                RoomNumber = "HALL-A",
                SeatNumber = seatStart++,
                ExamDate = new DateTime(2026, 11, 15),
                IsIssued = true,
                IssuedAt = DateTime.UtcNow,
                QRVerificationHash = Guid.NewGuid().ToString("N").ToUpperInvariant(),
                CreatedBy = "SuperAdmin"
            };
            Db.AdmitCards.Add(card);
            count++;
        }

        await Db.SaveChangesAsync();
        Snackbar.Add($"Generated & Issued {count} cryptographic QR Admit Cards.", Severity.Success);
        await ReloadDataAsync();
    }

    private async Task RunAntiSkipAuditAsync()
    {
        var unpaidWithAdmitCards = await Db.AdmitCards
            .Include(a => a.Enrollment).ThenInclude(e => e.Fees)
            .Where(a => !a.Enrollment.Fees.Any(f => f.Status == FeeStatus.Paid || f.Status == FeeStatus.Verified))
            .ToListAsync();

        if (unpaidWithAdmitCards.Count == 0)
        {
            Snackbar.Add("Anti-Skip Audit Passed: 100% of issued admit cards correspond to verified paid fees.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Anti-Skip Discrepancy: {unpaidWithAdmitCards.Count} admit cards flagged for unpaid fees.", Severity.Error);
        }
    }
}
