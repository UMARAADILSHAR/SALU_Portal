@code {
    private int totalApplications;
    private int pendingCount;
    private int approvedCount;
    private int rejectedCount;

    private List<EntityEnrollment> allEnrollments = [];
    private Dictionary<string, ApplicationUser> userMap = [];
    private List<AcademicYear> academicYearsList = [];
    private AcademicYear? activeAcademicYear;
    private List<EnrollmentWindow> enrollmentWindowsList = [];

    private EnrollmentSettings enrollmentSettings = new();
    private WindowEvaluationResult? windowStatus;

    private EntityEnrollment? selectedDossierApp;
    private EntityEnrollment? rejectingApp;
    private string rejectionReasonInput = string.Empty;

    private bool showAddAcademicYearModal;
    private string newAcademicYearName = string.Empty;
    private DateTime? newAcademicYearStartDate = DateTime.UtcNow;
    private DateTime? newAcademicYearEndDate = DateTime.UtcNow.AddYears(1);
    private AcademicYearStatus newAcademicYearStatus = AcademicYearStatus.Active;

    protected override async Task OnInitializedAsync()
    {
        await ReloadDataAsync();
    }

    private string GetCandidateName(EntityEnrollment? app)
    {
        if (app == null) return string.Empty;
        if (userMap.TryGetValue(app.UserId, out var user) && !string.IsNullOrWhiteSpace(user.FullName))
            return user.FullName;
        if (!string.IsNullOrWhiteSpace(app.Surname))
            return $"{app.FatherName} ({app.Surname})";
        return app.FatherName;
    }

    private async Task ReloadDataAsync()
    {
        enrollmentSettings = await ConfigService.GetEnrollmentSettingsAsync();
        windowStatus = await ConfigService.GetEnrollmentWindowStatusAsync();

        var users = await Db.Users.AsNoTracking().ToListAsync();
        userMap = users.ToDictionary(u => u.Id, u => u);

        academicYearsList = await Db.AcademicYears.AsNoTracking().OrderByDescending(y => y.StartDate).ToListAsync();
        activeAcademicYear = academicYearsList.FirstOrDefault(y => y.IsActive) ?? academicYearsList.FirstOrDefault();
        enrollmentWindowsList = await Db.EnrollmentWindows.Include(w => w.AcademicYear).AsNoTracking().OrderByDescending(w => w.StartDate).ToListAsync();

        allEnrollments = await Db.Enrollments
            .Include(e => e.College)
            .Include(e => e.Fees)
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();

        totalApplications = allEnrollments.Count;
        pendingCount = allEnrollments.Count(e => e.Status == EnrollmentStatus.Pending || e.Status == EnrollmentStatus.Draft);
        approvedCount = allEnrollments.Count(e => e.Status == EnrollmentStatus.Approved);
        rejectedCount = allEnrollments.Count(e => e.Status == EnrollmentStatus.Rejected);
    }

    private Color GetAcademicYearStatusColor(AcademicYearStatus status) => status switch
    {
        AcademicYearStatus.Active => Color.Success,
        AcademicYearStatus.Draft => Color.Warning,
        AcademicYearStatus.Closed => Color.Dark,
        AcademicYearStatus.Archived => Color.Default,
        _ => Color.Primary
    };

    private void OpenScrutinyModal(EntityEnrollment app) => selectedDossierApp = app;
    private void CloseScrutinyModal() => selectedDossierApp = null;
    private void PromptRejectModal(EntityEnrollment app) { rejectingApp = app; rejectionReasonInput = string.Empty; }

    private async Task AuthorizeCorrectionAsync(EntityEnrollment app)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await CorrectionService.AuthorizeAllFieldsAsync(app.Id, authState.User, "Administrative correction authorized after enrollment rejection.");
            Snackbar.Add($"Correction access opened for {app.ReferenceNumber}.", Severity.Warning);
            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmRejectionAsync()
    {
        if (rejectingApp == null) return;
        var entity = await Db.Enrollments.FindAsync(rejectingApp.Id);
        if (entity != null)
        {
            entity.Status = EnrollmentStatus.Rejected;
            entity.RejectionReason = string.IsNullOrWhiteSpace(rejectionReasonInput) ? "Document scrutiny requirements not met." : rejectionReasonInput;
            entity.LastModifiedAt = DateTime.UtcNow;
            entity.LastModifiedBy = "SuperAdmin";
            await Db.SaveChangesAsync();
            Snackbar.Add($"Application {rejectingApp.ReferenceNumber} rejected.", Severity.Warning);
        }
        rejectingApp = null;
        selectedDossierApp = null;
        await ReloadDataAsync();
    }

    private async Task ApproveApplicationAsync(EntityEnrollment app)
    {
        var entity = await Db.Enrollments.FindAsync(app.Id);
        if (entity != null)
        {
            entity.Status = EnrollmentStatus.Approved;
            entity.RejectionReason = null;
            if (string.IsNullOrWhiteSpace(entity.RollNumber))
            {
                entity.RollNumber = $"SALU-26-{new Random().Next(10000, 99999)}";
            }
            entity.LastModifiedAt = DateTime.UtcNow;
            entity.LastModifiedBy = "SuperAdmin";
            await Db.SaveChangesAsync();
            Snackbar.Add($"Application {app.ReferenceNumber} APPROVED (Roll No: {entity.RollNumber})", Severity.Success);
        }
        selectedDossierApp = null;
        await ReloadDataAsync();
    }

    private async Task BatchApproveVerifiedAsync()
    {
        var pending = allEnrollments.Where(e => e.Status == EnrollmentStatus.Pending || e.Status == EnrollmentStatus.Draft).ToList();
        int count = 0;
        var rand = new Random();
        foreach (var app in pending)
        {
            var entity = await Db.Enrollments.FindAsync(app.Id);
            if (entity != null)
            {
                entity.Status = EnrollmentStatus.Approved;
                if (string.IsNullOrWhiteSpace(entity.RollNumber))
                    entity.RollNumber = $"SALU-26-{rand.Next(10000, 99999)}";
                entity.LastModifiedAt = DateTime.UtcNow;
                entity.LastModifiedBy = "SuperAdmin";
                count++;
            }
        }
        if (count > 0)
        {
            await Db.SaveChangesAsync();
            Snackbar.Add($"Batch approved {count} candidate applications.", Severity.Success);
            await ReloadDataAsync();
        }
    }

    private async Task SaveScheduleSettingsAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await ConfigService.SaveEnrollmentSettingsAsync(enrollmentSettings, authState.User);
        Snackbar.Add("Automated Schedule & Late Fee Rules saved successfully.", Severity.Success);
        await ReloadDataAsync();
    }

    private async Task ToggleGlobalEnrollmentAsync()
    {
        enrollmentSettings.IsEnrollmentOpen = !enrollmentSettings.IsEnrollmentOpen;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await ConfigService.SaveEnrollmentSettingsAsync(enrollmentSettings, authState.User);
        Snackbar.Add(enrollmentSettings.IsEnrollmentOpen ? "Enrollment Portal OPENED." : "Enrollment Portal CLOSED.", enrollmentSettings.IsEnrollmentOpen ? Severity.Success : Severity.Warning);
        await ReloadDataAsync();
    }

    private async Task ToggleWindowStatusAsync(EnrollmentWindow window)
    {
        var w = await Db.EnrollmentWindows.FindAsync(window.Id);
        if (w != null)
        {
            w.IsOpen = !w.IsOpen;
            w.LastModifiedAt = DateTime.UtcNow;
            w.LastModifiedBy = "SuperAdmin";
            await Db.SaveChangesAsync();
            Snackbar.Add($"Window for {window.AcademicYear?.Name} is now {(w.IsOpen ? "OPEN" : "CLOSED")}.", Severity.Info);
            await ReloadDataAsync();
        }
    }

    private async Task MakeAcademicYearActiveAsync(AcademicYear year)
    {
        foreach (var y in await Db.AcademicYears.ToListAsync())
        {
            if (y.Id == year.Id) { y.IsActive = true; y.Status = AcademicYearStatus.Active; }
            else if (y.IsActive) { y.IsActive = false; y.Status = AcademicYearStatus.Closed; }
        }
        await Db.SaveChangesAsync();
        Snackbar.Add($"Academic Year {year.Name} marked as ACTIVE.", Severity.Success);
        await ReloadDataAsync();
    }

    private async Task CreateAcademicYearAsync()
    {
        if (string.IsNullOrWhiteSpace(newAcademicYearName))
        {
            Snackbar.Add("Title is required.", Severity.Error);
            return;
        }
        var year = new AcademicYear
        {
            Name = newAcademicYearName.Trim(),
            StartDate = newAcademicYearStartDate ?? DateTime.UtcNow,
            EndDate = newAcademicYearEndDate ?? DateTime.UtcNow.AddYears(1),
            Status = newAcademicYearStatus,
            IsActive = newAcademicYearStatus == AcademicYearStatus.Active
        };
        if (year.IsActive)
        {
            foreach (var y in await Db.AcademicYears.ToListAsync())
            {
                y.IsActive = false;
                if (y.Status == AcademicYearStatus.Active) y.Status = AcademicYearStatus.Closed;
            }
        }
        Db.AcademicYears.Add(year);
        Db.EnrollmentWindows.Add(new EnrollmentWindow
        {
            AcademicYear = year,
            StartDate = year.StartDate,
            EndDate = year.EndDate,
            IsOpen = year.IsActive
        });
        await Db.SaveChangesAsync();
        showAddAcademicYearModal = false;
        Snackbar.Add($"Academic Year {year.Name} created.", Severity.Success);
        await ReloadDataAsync();
    }
}
