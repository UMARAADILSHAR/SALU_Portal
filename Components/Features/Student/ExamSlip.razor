@page "/Student/ExamSlip"
@attribute [Authorize(Policy = "Student")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SaluExamPortal.Domain.Entities
@using EntityEnrollment = SaluExamPortal.Domain.Entities.Enrollment
@using SaluExamPortal.Infrastructure.Persistence
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Examination Slip &amp; Date Sheet - SALU</PageTitle>
<div class="salu-portal-app p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div><h2 class="m-0 text-navy fw-bold">Examination Schedule &amp; Seat Slip</h2><p class="text-muted m-0">Shah Abdul Latif University - Examination Directorate</p></div>
        <div class="d-flex gap-2"><a href="/Student" class="btn btn-outline">Back to Dashboard</a><button type="button" class="btn btn-primary" @onclick="PrintSlip">Print Exam Slip</button></div>
    </div>
    @if (loading)
    {
        <div class="card p-5 text-center"><div class="spinner-border text-primary mx-auto mb-2" role="status"></div><p class="text-muted mb-0">Loading examination date sheet...</p></div>
    }
    else if (enrollment is null)
    {
        <div class="card p-5 text-center"><div class="fs-1 mb-2">&#128203;</div><h4>No Active Examination Registration</h4><p class="text-muted">You do not have an active enrollment application for the current examination cycle.</p><a href="/Student/Enrollment" class="btn btn-accent">Submit Enrollment</a></div>
    }
    else
    {
        <div class="print-document print-exam-slip">
            <div class="card p-4 mb-4"><div class="row g-3 align-items-center">
                <div class="col-sm-6 col-lg-3"><small class="text-muted d-block">Candidate Roll Number</small><strong class="fs-5 text-navy">@(enrollment.RollNumber ?? "SALU-26-F-01492")</strong></div>
                <div class="col-sm-6 col-lg-3"><small class="text-muted d-block">Examination Center</small><strong class="d-block text-dark">Main Examination Hall, SALU Khairpur</strong></div>
                <div class="col-sm-6 col-lg-3"><small class="text-muted d-block">Room / Seat</small><strong class="d-block text-success">Room 12 | Seat #44</strong></div>
                <div class="col-sm-6 col-lg-3 text-sm-end"><span class="badge bg-success px-3 py-2">Confirmed Allotment</span></div>
            </div></div>
            <section class="card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4"><div><h5 class="fw-bold text-navy mb-1">Official Examination Date-Sheet</h5><p class="text-muted small mb-0">Semester 1 - all registered subjects and examination details.</p></div><span class="subject-count">@subjects.Count subjects</span></div>
                <div class="subject-grid" role="list" aria-label="Examination subjects">
                    @foreach (var subject in subjects)
                    {
                        <article class="subject-card" role="listitem"><div class="subject-card-top"><span class="subject-number">@subject.Number.ToString("00")</span><span class="badge bg-info text-dark">Scheduled</span></div><h6 class="subject-title">@subject.Title</h6><div class="subject-detail"><span>Date</span><strong>@subject.Date.ToString("dd MMM yyyy") (@subject.Date.ToString("ddd"))</strong></div><div class="subject-detail"><span>Time</span><strong>09:00 AM - 12:00 PM</strong></div><div class="subject-detail"><span>Venue</span><strong>Room 12 - Seat #44</strong></div></article>
                    }
                </div>
                <div class="mt-4 p-3 bg-light rounded border"><h6 class="fw-bold text-navy">Exam Day Guidelines:</h6><ul class="mb-0 ps-3 small text-muted"><li>Entry gates close strictly 15 minutes before the start of the paper.</li><li>Cheating materials, notes, and smart devices are prohibited.</li><li>For center inquiries, contact the Examination Control Room at <strong>0243-9280051</strong>.</li></ul></div>
            </section>
        </div>
    }
</div>
<style>
    .subject-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; } .subject-card { border:1px solid #dbe4ef; border-radius:.75rem; padding:1.1rem; background:linear-gradient(145deg,#fff,#f8fbff); box-shadow:0 4px 14px rgba(20,47,82,.06); } .subject-card-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:.85rem; } .subject-number { display:inline-flex; align-items:center; justify-content:center; width:2.25rem; height:2.25rem; border-radius:50%; background:#e7f0ff; color:#174a86; font-weight:800; } .subject-title { min-height:2.8rem; margin-bottom:1rem; color:#122d4d; font-weight:700; line-height:1.4; } .subject-detail { display:flex; justify-content:space-between; gap:1rem; padding-top:.55rem; margin-top:.55rem; border-top:1px solid #e8eef5; font-size:.82rem; } .subject-detail span { color:#718096; } .subject-detail strong { color:#263b53; text-align:right; } .subject-count { color:#174a86; font-size:.8rem; font-weight:700; background:#edf4ff; border-radius:999px; padding:.45rem .75rem; }
    @@media (max-width:640px) { .subject-grid { grid-template-columns:1fr; } .subject-detail { align-items:flex-start; flex-direction:column; gap:.1rem; } .subject-detail strong { text-align:left; } } @@media print { .subject-grid { grid-template-columns:repeat(2,1fr); gap:.6rem; } .subject-card { box-shadow:none; padding:.7rem; } .subject-title { min-height:auto; } }
</style>
@code {
    private ApplicationUser? user; private EntityEnrollment? enrollment; private bool loading = true;
    private readonly IReadOnlyList<ExamSubject> subjects = [new(1,"Introduction to Information Technology",new DateTime(2026,10,15)),new(2,"Functional English & Communication Skills",new DateTime(2026,10,18)),new(3,"Pakistan Studies & Islamic Ideology",new DateTime(2026,10,21)),new(4,"Calculus & Analytical Geometry",new DateTime(2026,10,25)),new(5,"Principles of Economics",new DateTime(2026,10,28)),new(6,"Introduction to Sociology",new DateTime(2026,10,31))];
    private sealed record ExamSubject(int Number,string Title,DateTime Date);
    protected override async Task OnInitializedAsync() { var authState=await AuthenticationStateProvider.GetAuthenticationStateAsync(); if(authState.User.Identity?.IsAuthenticated==true) { user=await UserManager.GetUserAsync(authState.User); if(user!=null) enrollment=await Db.Enrollments.AsNoTracking().Include(e=>e.College).OrderByDescending(e=>e.CreatedAt).FirstOrDefaultAsync(e=>e.UserId==user.Id); } loading=false; }
    private Task PrintSlip() => JS.InvokeVoidAsync("window.print").AsTask();
}
