@using SaluExamPortal.Domain.Entities

<header class="salu-hero-header">
    <div class="salu-hero-inner">
        <div class="salu-brand-block">
            <div class="salu-crest-wrap">
                <img src="images/salu-logo.png" alt="SALU Crest" style="width:100%;height:100%;object-fit:contain;" />
            </div>
            <div class="salu-title-group">
                <h1 class="salu-portal-title">SHAH ABDUL LATIF UNIVERSITY, KHAIRPUR</h1>
                <div class="salu-sub-bar">
                    <span class="salu-badge-caps">DIRECTORATE OF EXAMINATIONS</span>
                    <span class="salu-divider">•</span>
                    <span class="salu-portal-url">OFFICIAL IOC ENROLLMENT SYSTEM</span>
                </div>
            </div>
        </div>
        <div class="salu-session-card">
            <div class="salu-session-label">ACADEMIC SESSION</div>
            <div class="salu-session-val">@(ActiveAcademicYear?.Name ?? DefaultSession)</div>
            <div class="salu-date-tag">@DateTime.Now.ToString("dd MMMM yyyy").ToUpperInvariant()</div>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public AcademicYear? ActiveAcademicYear { get; set; }

    [Parameter]
    public string DefaultSession { get; set; } = "2026-2027";
}
