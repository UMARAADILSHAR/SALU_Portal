        }
        catch (Exception ex)
        {
            generalErrorMessage = ex.Message.ToUpperInvariant();
            Toast.ShowError("Submission failed. Please check the errors and try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task PrintForm()
    {
        await JS.InvokeVoidAsync("window.print");
    }

