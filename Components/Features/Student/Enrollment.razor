        "BISE SHAHEED BENAZIRABAD",
        "FEDERAL BOARD (FBISE)",
        "AGA KHAN BOARD",
        "OTHER BOARD"
    ];

    // Dynamic document requirements checklist
    private sealed record DocumentSpec(string DocType, string Description, bool IsMandatory);

    private List<DocumentSpec> standardDocumentSpecs = [
        new("COPY OF CNIC / B-FORM", "Clear readable copy of Candidate National ID Card or NADRA B-Form", true),
        new("COPY OF INTERMEDIATE MARKSHEET", "Original Intermediate / HSSC Part-II Marks Certificate with Seat No & Marks", true),
        new("COPY OF MATRIC MARKSHEET", "Original Matriculation / SSC Part-II Marks Certificate with Board Seat No", false),
        new("PASSPORT SIZE PHOTOGRAPH", "Recent passport size color photograph with white or light blue background", true),
        new("COPY OF DOMICILE & PRC", "Permanent Residence Certificate (Form C) and Domicile Certificate (Optional)", false)
    ];

    private int GetUploadedMandatoryCount()
    {
        return standardDocumentSpecs.Count(s => s.IsMandatory && GetDocumentByType(s.DocType) != null);
    }

    private int GetTotalMandatoryCount()
    {
        return standardDocumentSpecs.Count(s => s.IsMandatory);
    }

    private double GetDocumentUploadProgressPercent()
    {
        var total = standardDocumentSpecs.Count;
        if (total == 0) return 0;
        var uploaded = standardDocumentSpecs.Count(s => GetDocumentByType(s.DocType) != null);
        return Math.Round((double)uploaded / total * 100, 1);
    }

    private static string GetDocIcon(string? docType)
    {
        if (string.IsNullOrWhiteSpace(docType)) return "bi-file-earmark-text-fill";
        var dt = docType.ToUpperInvariant();
        if (dt.Contains("CNIC") || dt.Contains("B-FORM")) return "bi-person-vcard-fill";
        if (dt.Contains("INTER")) return "bi-mortarboard-fill";
        if (dt.Contains("MATRIC")) return "bi-award-fill";
        if (dt.Contains("PHOTO")) return "bi-person-bounding-box";
        if (dt.Contains("DOMICILE") || dt.Contains("PRC")) return "bi-geo-alt-fill";
        return "bi-file-earmark-text-fill";
    }

    // Fixed 2-Row Academic State (Starts Clean & Empty)
    private string matricDiscipline = "";
    private int matricYear = 0;
    private string matricSeat = "";
    private int? matricObtained = null;
    private int? matricTotal = null;
    private double matricPercentage = 0;
    private string matricGrade = "";
    private string matricBoard = "";

    private string interDiscipline = "";
    private int interYear = 0;
    private string interSeat = "";
    private int? interObtained = null;
    private int? interTotal = null;
    private double interPercentage = 0;
    private string interGrade = "";
    private string interBoard = "";

    private List<AcademicRecordItem> academicRecords = [];

    // Document attachments
    private List<UploadedDocumentItem> uploadedDocuments = [];
    private string? processingDocType;
    private UploadedDocumentItem? previewModalDoc;

    // Photo state
    private string? photoPreviewUrl;
    private bool uploadingPhoto;

    private EntityEnrollment? existingEnrollment;
    private WindowEvaluationResult? windowStatus;
    private bool isSubmitted => existingEnrollment != null && existingEnrollment.Status != EnrollmentStatus.Draft;
    private bool isWindowClosed => windowStatus != null && !windowStatus.IsActive;
    private bool isDraftResumed;
    private bool isCorrectionAuthorized;
    private bool showErrors;
    private bool isSubmitting;
    private string? generalErrorMessage;
    private string generatedReferenceNumber = "SALU-2026-000000";
    private string? selectedCollegeName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            windowStatus = await ConfigService.GetEnrollmentWindowStatusAsync();
        }
        catch { }

        allColleges = await Db.Colleges.AsNoTracking().Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        filteredColleges = allColleges;
        academicYearsList = await Db.AcademicYears.AsNoTracking().Where(y => y.IsActive).OrderByDescending(y => y.StartDate).ToListAsync();
        activeAcademicYear = academicYearsList.FirstOrDefault();
        if (activeAcademicYear != null)
        {
            Input.AcademicYearName = activeAcademicYear.Name;
        }

        CalculateMatricPercentage();
        CalculateInterPercentage();
        SyncAcademicRecords();

        try
        {
            var docReqs = await ConfigService.GetDocumentRequirementsAsync();
            standardDocumentSpecs = [
                new("COPY OF CNIC / B-FORM", "Clear readable copy of Candidate National ID Card or NADRA B-Form", docReqs.CnicRequired),
                new("COPY OF INTERMEDIATE MARKSHEET", "Original Intermediate / HSSC Part-II Marks Certificate with Seat No & Marks", docReqs.IntermediateMarksheetRequired),
                new("COPY OF MATRIC MARKSHEET", "Original Matriculation / SSC Part-II Marks Certificate with Board Seat No", docReqs.MatricCertificateRequired),
                new("PASSPORT SIZE PHOTOGRAPH", "Recent passport size color photograph with white or light blue background", docReqs.PhotoRequired),
                new("COPY OF DOMICILE & PRC", "Permanent Residence Certificate (Form C) and Domicile Certificate (Optional)", docReqs.DomicilePrcRequired)
            ];
        }
        catch { }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(authState.User);
            if (currentUser != null)
            {
                // Lock registration data
                Input.FullName = (currentUser.FullName ?? "").ToUpperInvariant();
                Input.FatherName = (currentUser.FatherName ?? "").ToUpperInvariant();
                Input.Cnic = currentUser.Cnic ?? "";
                Input.ContactNumber = currentUser.PhoneNumber ?? "";

                existingEnrollment = await Db.Enrollments
                    .AsNoTracking()
                    .Include(e => e.College)
                    .Include(e => e.Fees)
                    .OrderByDescending(e => e.CreatedAt)
                    .FirstOrDefaultAsync(e => e.UserId == currentUser.Id);

                 isCorrectionAuthorized = existingEnrollment?.Status == EnrollmentStatus.Rejected
                     && await EnrollmentCorrectionService.HasApprovedCorrectionAsync(existingEnrollment.Id, currentUser.Id);

                if (existingEnrollment != null)
                {
                     if (existingEnrollment.Status != EnrollmentStatus.Draft)
                     {
                         currentStep = TOTAL_STEPS + 1;
                     }

                    // Restore data from existing enrollment / draft (without fake mock fallbacks)
                    Input.CollegeId = existingEnrollment.CollegeId;
                    Input.Program = (existingEnrollment.Program ?? "").ToUpperInvariant();
                    Input.AdmittedDistrict = (existingEnrollment.College?.District ?? existingEnrollment.DomicileDistrict ?? "").ToUpperInvariant();
                    if (!string.IsNullOrWhiteSpace(existingEnrollment.FatherName))
                    {
                        Input.FatherName = existingEnrollment.FatherName.ToUpperInvariant();
                    }
                    Input.Surname = (existingEnrollment.Surname ?? "").ToUpperInvariant();
                    Input.SoDoWo = (existingEnrollment.SoDoWo ?? "").ToUpperInvariant();
                    Input.DateOfBirth = existingEnrollment.DateOfBirth;
                    Input.Gender = existingEnrollment.Gender;
                    Input.Address = (existingEnrollment.Address ?? "").ToUpperInvariant();
                    Input.DomicileDistrict = (existingEnrollment.DomicileDistrict ?? "").ToUpperInvariant();
                    Input.DomicileProvince = (existingEnrollment.DomicileProvince ?? "").ToUpperInvariant();
                    Input.DivisionObtained = (existingEnrollment.DivisionObtained ?? "").ToUpperInvariant();
                    Input.PassingYear = existingEnrollment.PassingYear ?? 0;
                    Input.BoardName = (existingEnrollment.BoardName ?? "").ToUpperInvariant();
                    Input.ExamFromSalu = (existingEnrollment.ExamFromSalu ?? "NO").ToUpperInvariant();
                    Input.SaluSeatNo = (existingEnrollment.SaluSeatNo ?? "").ToUpperInvariant();
                    Input.SaluExamYear = (existingEnrollment.SaluExamYear ?? "").ToUpperInvariant();
                    Input.EligibilityCertNo = (existingEnrollment.EligibilityCertNo ?? "").ToUpperInvariant();
                    Input.PhotoUrl = existingEnrollment.PhotoUrl;
                    photoPreviewUrl = existingEnrollment.PhotoUrl;
                    generatedReferenceNumber = existingEnrollment.ReferenceNumber ?? "SALU-2026-000000";

                    if (!string.IsNullOrWhiteSpace(existingEnrollment.AcademicRecordsJson))
                    {
                        try 
                        { 
                            var loaded = JsonSerializer.Deserialize<List<AcademicRecordItem>>(existingEnrollment.AcademicRecordsJson);
                            if (loaded != null && loaded.Count > 0)
                            {
                                var matricRec = loaded.FirstOrDefault(r => r.Qualification.Contains("MATRIC", StringComparison.OrdinalIgnoreCase));
                                if (matricRec != null)
                                {
                                    matricDiscipline = string.IsNullOrWhiteSpace(matricRec.Degree) || matricRec.Degree == "—" ? "" : matricRec.Degree;
                                    matricYear = matricRec.PassingYear;
                                    matricSeat = matricRec.SeatNo;
                                    matricObtained = matricRec.MarksObtained > 0 ? matricRec.MarksObtained : null;
                                    matricTotal = matricRec.TotalMarks > 0 ? matricRec.TotalMarks : null;
                                    matricGrade = matricRec.GradeDivision;
                                    matricBoard = matricRec.BoardUniversity;
                                    CalculateMatricPercentage();
                                }

                                var interRec = loaded.FirstOrDefault(r => r.Qualification.Contains("INTER", StringComparison.OrdinalIgnoreCase));
                                if (interRec != null)
                                {
                                    interDiscipline = string.IsNullOrWhiteSpace(interRec.Degree) || interRec.Degree == "—" ? "" : interRec.Degree;
                                    interYear = interRec.PassingYear;
                                    interSeat = interRec.SeatNo;
                                    interObtained = interRec.MarksObtained > 0 ? interRec.MarksObtained : null;
                                    interTotal = interRec.TotalMarks > 0 ? interRec.TotalMarks : null;
                                    interGrade = interRec.GradeDivision;
                                    interBoard = interRec.BoardUniversity;
                                    CalculateInterPercentage();
                                }
                                SyncAcademicRecords();
                            }
                        } 
                        catch { }
                    }
                    if (!string.IsNullOrWhiteSpace(existingEnrollment.DocumentsJson))
                    {
                        try { uploadedDocuments = JsonSerializer.Deserialize<List<UploadedDocumentItem>>(existingEnrollment.DocumentsJson) ?? uploadedDocuments; } catch { }
                    }

                    // Apply cascading filters for restored college/district
                    if (!string.IsNullOrWhiteSpace(Input.AdmittedDistrict))
                    {
                        filteredColleges = allColleges.Where(c => c.District.Equals(Input.AdmittedDistrict, StringComparison.OrdinalIgnoreCase)).ToList();
                    }

                    if (Input.CollegeId.HasValue)
                    {
                        availablePrograms = await Db.CollegePrograms.Where(p => p.CollegeId == Input.CollegeId && p.IsActive).ToListAsync();
                        var college = allColleges.FirstOrDefault(c => c.Id == Input.CollegeId);
                        selectedCollegeName = college?.Name;
                    }

                    if (existingEnrollment.Status == EnrollmentStatus.Draft)
                    {
                        isDraftResumed = true;
                    }
                }
            }
        }

        await RefreshFeeAsync();
    }

