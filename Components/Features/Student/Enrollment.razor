    // ================= STEP 2: MATRIC & INTER AUTO-CALCULATION =================
    private void CalculateMatricPercentage()
    {
        OnFieldChanged();
        if (matricObtained.HasValue && matricTotal.HasValue && matricTotal.Value > 0)
        {
            matricPercentage = Math.Round((double)matricObtained.Value / matricTotal.Value * 100.0, 2);
            matricGrade = matricPercentage switch
            {
                >= 80.0 => "A-ONE",
                >= 70.0 => "A",
                >= 60.0 => "B",
                >= 50.0 => "C",
                >= 40.0 => "D",
                _ => "E"
            };
        }
        else
        {
            matricPercentage = 0;
        }
        SyncAcademicRecords();
    }

    private void CalculateInterPercentage()
    {
        OnFieldChanged();
        if (interObtained.HasValue && interTotal.HasValue && interTotal.Value > 0)
        {
            interPercentage = Math.Round((double)interObtained.Value / interTotal.Value * 100.0, 2);
            interGrade = interPercentage switch
            {
                >= 80.0 => "A-ONE",
                >= 70.0 => "A",
                >= 60.0 => "B",
                >= 50.0 => "C",
                >= 40.0 => "D",
                _ => "E"
            };
        }
        else
        {
            interPercentage = 0;
        }
        SyncAcademicRecords();
    }

