    private static bool IsImageFile(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return false;
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp";
    }

    private async Task OnRowFileSelected(InputFileChangeEventArgs e, string docType)
    {
        if (isSubmitted)
        {
            Toast.ShowInfo("This enrollment has been submitted and is permanently locked.");
            return;
        }

        var file = e.File;
        if (file == null) return;

        processingDocType = docType;
        generalErrorMessage = null;

        try
        {
            using var fileStream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var docItem = await FileStorageService.SaveDocumentAsync(memoryStream, file.Name, docType.ToUpperInvariant());

            var finalDoc = docItem;

            uploadedDocuments.RemoveAll(d => d.DocumentType.Equals(docType, StringComparison.OrdinalIgnoreCase));
            uploadedDocuments.Add(finalDoc);

            if (docType.Equals("PASSPORT SIZE PHOTOGRAPH", StringComparison.OrdinalIgnoreCase))
            {
                photoPreviewUrl = finalDoc.RelativePath;
                Input.PhotoUrl = finalDoc.RelativePath;
            }

            await SaveDraftAsync();
            if (currentUser != null)
            {
                var savedEnrollment = await Db.Enrollments
                    .Where(enrollment => enrollment.UserId == currentUser.Id)
                    .OrderByDescending(enrollment => enrollment.CreatedAt)
                    .FirstOrDefaultAsync();
                if (savedEnrollment != null)
                {
                    Db.EnrollmentDocuments.Add(new EnrollmentDocument
                    {
                        EnrollmentId = savedEnrollment.Id,
                        FileId = docItem.Id,
                        FileName = docItem.FileName,
                        RelativePath = docItem.RelativePath,
                        DocumentType = docItem.DocumentType,
                        FileSizeBytes = docItem.FileSizeBytes,
                        ProcessingStatus = "Queued"
                    });
                    await Db.SaveChangesAsync();
                }
            }
            Toast.ShowSuccess($"{docType} uploaded. OCR verification is processing in the background.");
        }
        catch (Exception ex)
        {
            generalErrorMessage = $"Upload failed for {docType}: {ex.Message}";
            Toast.ShowError($"Upload failed for {docType}. Please try again.");
        }
        finally
        {
            processingDocType = null;
        }
    }

