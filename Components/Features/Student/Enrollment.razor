    private bool ValidateStep(int step, out string? errorMessage)
    {
        errorMessage = null;
        if (step == 1)
        {
            if (string.IsNullOrWhiteSpace(Input.AdmittedDistrict))
            {
                errorMessage = "Admitted District is mandatory. Please select your admitted district.";
                return false;
            }
            if (!Input.CollegeId.HasValue)
            {
                errorMessage = "Admitted College is mandatory. Please select your college.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.Program))
            {
                errorMessage = "Admitted Degree Program is mandatory. Please select your program.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.AcademicYearName))
            {
                errorMessage = "Academic Year is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.FullName))
            {
                errorMessage = "Candidate Full Name is required.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.SoDoWo))
            {
                errorMessage = "Relation (S/O, D/O, or W/O) is mandatory. Please select relation.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.FatherName))
            {
                errorMessage = "Father's Name is mandatory. Please enter father's name.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.Cnic))
            {
                errorMessage = "CNIC / B-Form is mandatory.";
                return false;
            }
            if (Input.DateOfBirth == default || Input.DateOfBirth >= DateTime.Today.AddYears(-12) || Input.DateOfBirth <= DateTime.Today.AddYears(-90))
            {
                errorMessage = "Valid Date of Birth is mandatory (Candidate must be between 12 and 80 years old).";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.DivisionObtained))
            {
                errorMessage = "Division / Grade is mandatory in personal profile.";
                return false;
            }
            if (Input.PassingYear <= 0)
            {
                errorMessage = "Passing Year is mandatory. Please select passing year.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.BoardName))
            {
                errorMessage = "Board of Examination is mandatory. Please select your board.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.Address))
            {
                errorMessage = "Permanent Postal Address is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.Nationality))
            {
                errorMessage = "Nationality is mandatory. Please select nationality.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.Religion))
            {
                errorMessage = "Religion is mandatory. Please select religion.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.DomicileProvince))
            {
                errorMessage = "Domicile Province is mandatory. Please select province.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(Input.DomicileDistrict))
            {
                errorMessage = "Domicile District is mandatory. Please select domicile district.";
                return false;
            }
            if (Input.ExamFromSalu == "YES")
            {
                if (string.IsNullOrWhiteSpace(Input.SaluSeatNo))
                {
                    errorMessage = "Previous SALU Seat Number is mandatory when Exam from SALU is YES.";
                    return false;
                }
                if (string.IsNullOrWhiteSpace(Input.SaluExamYear))
                {
                    errorMessage = "Previous SALU Exam Year is mandatory when Exam from SALU is YES.";
                    return false;
                }
            }
            if (string.IsNullOrWhiteSpace(Input.PhotoUrl) && string.IsNullOrWhiteSpace(photoPreviewUrl))
            {
                errorMessage = "Passport Size Photograph is mandatory. Please upload your photo.";
                return false;
            }
            return true;
        }
        else if (step == 2)
        {
            if (string.IsNullOrWhiteSpace(matricDiscipline))
            {
                errorMessage = "Matriculation Discipline / Group is mandatory.";
                return false;
            }
            if (matricYear <= 0)
            {
                errorMessage = "Matriculation Passing Year is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(matricSeat))
            {
                errorMessage = "Matriculation Roll / Seat Number is mandatory.";
                return false;
            }
            if (!matricObtained.HasValue || matricObtained < 0)
            {
                errorMessage = "Matriculation Marks Obtained is mandatory.";
                return false;
            }
            if (!matricTotal.HasValue || matricTotal <= 0)
            {
                errorMessage = "Matriculation Total Marks is mandatory.";
                return false;
            }
            if (matricObtained > matricTotal)
            {
                errorMessage = "Matriculation Obtained Marks cannot exceed Total Marks.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(matricGrade))
            {
                errorMessage = "Matriculation Grade is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(matricBoard))
            {
                errorMessage = "Matriculation Board is mandatory.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(interDiscipline))
            {
                errorMessage = "Intermediate Discipline / Group is mandatory.";
                return false;
            }
            if (interYear <= 0)
            {
                errorMessage = "Intermediate Passing Year is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(interSeat))
            {
                errorMessage = "Intermediate Roll / Seat Number is mandatory.";
                return false;
            }
            if (!interObtained.HasValue || interObtained < 0)
            {
                errorMessage = "Intermediate Marks Obtained is mandatory.";
                return false;
            }
            if (!interTotal.HasValue || interTotal <= 0)
            {
                errorMessage = "Intermediate Total Marks is mandatory.";
                return false;
            }
            if (interObtained > interTotal)
            {
                errorMessage = "Intermediate Obtained Marks cannot exceed Total Marks.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(interGrade))
            {
                errorMessage = "Intermediate Grade is mandatory.";
                return false;
            }
            if (string.IsNullOrWhiteSpace(interBoard))
            {
                errorMessage = "Intermediate Board is mandatory.";
                return false;
            }

            SyncAcademicRecords();
            return true;
        }
        else if (step == 3)
        {
            var missingMandatory = standardDocumentSpecs
                .Where(s => s.IsMandatory && GetDocumentByType(s.DocType) == null)
                .Select(s => s.DocType)
                .ToList();

            if (missingMandatory.Count > 0)
            {
                errorMessage = $"Missing mandatory documents: {string.Join(", ", missingMandatory)}. Please attach all required documents.";
                return false;
            }
            return true;
        }
        return true;
    }

    private async Task NavigateToStepAsync(int targetStep)
    {
        if (isSubmitted)
        {
            Toast.ShowInfo("Application is submitted. Form tabs are locked in read-only mode.");
            return;
        }

        if (isWindowClosed)
        {
            Toast.ShowWarning("Enrollment portal is closed. Submission tabs are disabled.");
            return;
        }

        if (targetStep < 1 || targetStep > TOTAL_STEPS + 1) return;

        if (targetStep == currentStep) return;

        // Strict Step Guard: When moving forward, validate all preceding steps sequentially
        if (targetStep > currentStep)
        {
            for (int s = 1; s < targetStep; s++)
            {
                if (!ValidateStep(s, out var stepError))
                {
                    currentStep = s;
                    showErrors = true;
                    generalErrorMessage = stepError?.ToUpperInvariant();
                    Toast.ShowWarning(stepError ?? $"Please complete all required fields in Step {s} before proceeding.");
                    return;
                }
                completedSteps.Add(s);
            }
        }

        await SaveDraftAsync();
        currentStep = targetStep;
        showErrors = false;
        generalErrorMessage = null;
    }

    private async Task ValidateAndGoStepAsync(int nextStep)
    {
        if (isSubmitted)
        {
            Toast.ShowInfo("Application is submitted and locked. Modifications are disabled.");
            return;
        }

        if (isWindowClosed)
        {
            Toast.ShowWarning("Enrollment portal is closed. Modifications are disabled.");
            return;
        }

        showErrors = true;
        generalErrorMessage = null;

        if (!ValidateStep(currentStep, out var err))
        {
            generalErrorMessage = err?.ToUpperInvariant();
            Toast.ShowWarning(err ?? "Please complete all required fields.");
            return;
        }

        completedSteps.Add(currentStep);
        await SaveDraftAsync();
        currentStep = nextStep;
        showErrors = false;
        generalErrorMessage = null;
    }

