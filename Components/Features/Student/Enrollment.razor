        "KHAIRPUR", "SUKKUR", "GHOTKI", "LARKANA", "SHIKARPUR",
        "JACOBABAD", "KASHMORE", "NAUSHAHRO FEROZE", "SHAHEED BENAZIRABAD",
        "HYDERABAD", "KARACHI", "MIRPURKHAS", "BADIN", "THATTA", "DADU", "OTHER"
    ];

