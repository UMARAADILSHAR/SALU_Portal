    // ================= PHOTO UPLOAD =================
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (isSubmitted)
        {
            Toast.ShowInfo("This enrollment has been submitted and is permanently locked.");
            return;
        }

        var file = e.File;
        if (file == null) return;

        uploadingPhoto = true;
        generalErrorMessage = null;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var savedPath = await FileStorageService.SavePhotoAsync(stream, file.Name);
            photoPreviewUrl = savedPath;
            Input.PhotoUrl = savedPath;
            
            // Also ensure passport photo is reflected in document vault
            var photoDoc = new UploadedDocumentItem(
                Id: Guid.NewGuid().ToString(),
                FileName: file.Name,
                RelativePath: savedPath,
                DocumentType: "PASSPORT SIZE PHOTOGRAPH",
                FileSizeBytes: file.Size,
                UploadedAt: DateTime.UtcNow,
                OcrResult: null,
                Authenticity: new DocumentAuthenticityResult(true, "Verified", 100, "PASSPORT SIZE PHOTOGRAPH", "Valid Photo", null, Input.FullName, null, null, null, null, null, null, true, true, true, true, true, true, true, "Photo uploaded")
            );
            uploadedDocuments.RemoveAll(d => d.DocumentType.Equals("PASSPORT SIZE PHOTOGRAPH", StringComparison.OrdinalIgnoreCase));
            uploadedDocuments.Add(photoDoc);

            await SaveDraftAsync();
            Toast.ShowSuccess("Passport photo uploaded and saved successfully.");
        }
        catch (Exception ex)
        {
            generalErrorMessage = $"Photo upload failed: {ex.Message}";
            Toast.ShowError("Photo upload failed. Please try again.");
        }
        finally
        {
            uploadingPhoto = false;
        }
    }

