@code {
    private ApplicationUser? user;
    private EntityEnrollment? latestEnrollment;
    private AcademicYear? activeAcademicYear;
    private bool loading = true;

    // Live clock state
    private DateTime currentTime = DateTime.Now;
    private double hourDegree;
    private double minuteDegree;
    private double secondDegree;
    private PeriodicTimer? clockTimer;
    private CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                if (user.AdmissionType == AdmissionType.UniversityRegular)
                {
                    NavigationManager.NavigateTo("Student/UniversityAdmission", replace: true);
                    return;
                }

                latestEnrollment = await Db.Enrollments
                    .Include(e => e.College)
                    .Include(e => e.Fees)
                    .Include(e => e.AdmitCard)
                    .OrderByDescending(e => e.CreatedAt)
                    .FirstOrDefaultAsync(e => e.UserId == user.Id);
            }
        }

        activeAcademicYear = await Db.AcademicYears.FirstOrDefaultAsync(y => y.IsActive);
        loading = false;

        // Initialize clock calculations
        UpdateClock();

        // Start background 1-second live clock timer
        _ = StartClockLoopAsync(cts.Token);
    }

    private async Task StartClockLoopAsync(CancellationToken cancellationToken)
    {
        clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await clockTimer.WaitForNextTickAsync(cancellationToken))
            {
                UpdateClock();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on component disposal
        }
    }

    private void UpdateClock()
    {
        currentTime = DateTime.Now;
        secondDegree = currentTime.Second * 6; // 360 / 60
        minuteDegree = currentTime.Minute * 6 + (currentTime.Second * 0.1);
        hourDegree = (currentTime.Hour % 12) * 30 + (currentTime.Minute * 0.5);
    }

    public async ValueTask DisposeAsync()
    {
        cts.Cancel();
        clockTimer?.Dispose();
        cts.Dispose();
        await Task.CompletedTask;
    }
}
