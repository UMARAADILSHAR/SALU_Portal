@page "/Student/AdmitCard"
@attribute [Authorize(Policy = "Student")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SaluExamPortal.Domain.Entities
@using EntityEnrollment = SaluExamPortal.Domain.Entities.Enrollment
@using SaluExamPortal.Domain.Enums
@using SaluExamPortal.Infrastructure.Persistence
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject IToastService Toast

<PageTitle>Examination Admit Card - SALU</PageTitle>

<div class="salu-portal-app p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <h2 class="m-0 text-navy fw-bold">Examination Admit Card</h2>
            <p class="text-muted m-0">Shah Abdul Latif University — Controller of Examinations</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Student" class="btn btn-outline">← Back to Dashboard</a>
            <button type="button" class="btn btn-primary" @onclick="PrintAdmitCard">🖨 Print Admit Card</button>
        </div>
    </div>

    @if (loading)
    {
        <div class="card p-5 text-center">
            <div class="spinner-border text-primary mx-auto mb-2" role="status"></div>
            <p class="text-muted">Loading your official admit card...</p>
        </div>
    }
    else if (enrollment is null)
    {
        <div class="card p-5 text-center">
            <div class="fs-1 mb-2">🎫</div>
            <h4>No Enrollment Found</h4>
            <p class="text-muted">You have not submitted an enrollment application yet. Please submit your application first.</p>
            <div class="mt-3">
                <a href="/Student/Enrollment" class="btn btn-accent">Apply for Enrollment</a>
            </div>
        </div>
    }
    else
    {
        var rollNumber = enrollment.RollNumber ?? $"SALU-{DateTime.Now:yy}-F-01492";
        var isIssued = enrollment.Status == EnrollmentStatus.Approved || enrollment.AdmitCard?.IsIssued == true;

         <div class="admit-card-paper print-document print-admit-card">
            <!-- HEADER -->
            <div class="d-flex align-items-center justify-content-between pb-3 border-bottom border-2 border-navy">
                <div class="d-flex align-items-center gap-3">
                    <img src="images/salu-logo.png" alt="SALU Crest" style="width:65px;height:65px;object-fit:contain;" />
                    <div>
                        <h4 class="m-0 fw-bold text-navy" style="font-family:'Merriweather',serif;">SHAH ABDUL LATIF UNIVERSITY</h4>
                        <div class="small fw-semibold text-muted">KHAIRPUR, SINDH, PAKISTAN</div>
                        <div class="badge bg-primary text-white mt-1 px-3 py-1" style="font-size:0.75rem;letter-spacing:0.06em;">
                            OFFICIAL EXAMINATION ADMIT CARD / ROLL NUMBER SLIP
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-bold text-navy" style="font-size:0.9rem;">Annual Examination @DateTime.Now.Year</div>
                    <small class="text-muted d-block">Session: @(enrollment.Session ?? $"{DateTime.Now.Year}-{DateTime.Now.Year+1}")</small>
                    <div class="text-success fw-bold" style="font-size:0.78rem;">✓ VERIFIED &amp; ISSUED</div>
                </div>
            </div>

            <!-- CANDIDATE DETAILS + PHOTO -->
            <div class="row g-3 my-3 align-items-stretch">
                <div class="col-9">
                    <table class="table table-bordered table-sm m-0 admit-table">
                        <tbody>
                            <tr>
                                <th style="width:30%;">Roll Number</th>
                                <td class="fw-bold text-navy fs-6">@rollNumber</td>
                                <th style="width:20%;">Reg. / Ref No</th>
                                <td>@enrollment.ReferenceNumber</td>
                            </tr>
                            <tr>
                                <th>Candidate Name</th>
                                <td colspan="3"><strong>@(user?.FullName ?? "Candidate")</strong></td>
                            </tr>
                            <tr>
                                <th>Father's Name</th>
                                <td colspan="3">@enrollment.FatherName</td>
                            </tr>
                            <tr>
                                <th>CNIC / B-Form</th>
                                <td>@(user?.Cnic ?? enrollment.ReferenceNumber)</td>
                                <th>Gender</th>
                                <td>@enrollment.Gender</td>
                            </tr>
                            <tr>
                                <th>Admitted College</th>
                                <td colspan="3">@(enrollment.College?.Name ?? "Govt. Superior Science College Khairpur")</td>
                            </tr>
                            <tr>
                                <th>Program / Degree</th>
                                <td><strong>@enrollment.Program</strong></td>
                                <th>Semester</th>
                                <td>Semester @enrollment.Semester</td>
                            </tr>
                            <tr class="table-light">
                                <th>Examination Center</th>
                                <td colspan="3" class="fw-bold text-navy">
                                    @(enrollment.Seat?.ExamCenter ?? "Main Campus Examination Hall A, Shah Abdul Latif University Khairpur")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-3 d-flex flex-column align-items-center justify-content-center border rounded p-2 bg-light">
                    @if (!string.IsNullOrWhiteSpace(enrollment.PhotoUrl))
                    {
                        <img src="@enrollment.PhotoUrl" alt="Candidate Photo" class="img-fluid rounded border" style="max-height:160px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="text-center p-3 border rounded bg-white w-100" style="height:150px;display:flex;align-items:center;justify-content:center;">
                            <span class="text-muted small">Official Photo Affixed</span>
                        </div>
                    }
                    <small class="text-muted mt-2 fw-bold" style="font-size:0.7rem;">Verified Candidate</small>
                </div>
            </div>

            <!-- EXAM SCHEDULE / SUBJECTS -->
            <h6 class="fw-bold text-navy border-bottom pb-1 mb-2">Subject Examination Schedule</h6>
            <table class="table table-bordered table-sm text-center align-middle m-0" style="font-size:0.8rem;">
                <thead class="table-dark">
                    <tr>
                        <th style="width:10%;">Course Code</th>
                        <th style="width:40%;">Course / Paper Title</th>
                        <th style="width:18%;">Date</th>
                        <th style="width:16%;">Timing</th>
                        <th style="width:16%;">Room &amp; Seat</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>CSC-101</strong></td>
                        <td class="text-start ps-3">Introduction to Information Technology</td>
                        <td>15 Oct @DateTime.Now.Year</td>
                        <td>09:00 AM – 12:00 PM</td>
                        <td>Room 12 (Seat 44)</td>
                    </tr>
                    <tr>
                        <td><strong>ENG-101</strong></td>
                        <td class="text-start ps-3">Functional English &amp; Communication Skills</td>
                        <td>18 Oct @DateTime.Now.Year</td>
                        <td>09:00 AM – 12:00 PM</td>
                        <td>Room 12 (Seat 44)</td>
                    </tr>
                    <tr>
                        <td><strong>PST-101</strong></td>
                        <td class="text-start ps-3">Pakistan Studies &amp; Islamic Ideology</td>
                        <td>21 Oct @DateTime.Now.Year</td>
                        <td>09:00 AM – 12:00 PM</td>
                        <td>Room 12 (Seat 44)</td>
                    </tr>
                    <tr>
                        <td><strong>MTH-101</strong></td>
                        <td class="text-start ps-3">Calculus &amp; Analytical Geometry</td>
                        <td>25 Oct @DateTime.Now.Year</td>
                        <td>09:00 AM – 12:00 PM</td>
                        <td>Room 12 (Seat 44)</td>
                    </tr>
                </tbody>
            </table>

            <!-- INSTRUCTIONS & SIGNATURES -->
            <div class="row mt-4 pt-3 border-top g-3" style="font-size:0.72rem;">
                <div class="col-8">
                    <strong class="text-danger d-block mb-1">IMPORTANT CANDIDATE INSTRUCTIONS:</strong>
                    <ul class="m-0 ps-3 text-muted">
                        <li>You must bring your <strong>Original CNIC</strong> and this printed <strong>Admit Card</strong> to every examination session.</li>
                        <li>Mobile phones, smartwatches, calculators, and unauthorized materials are strictly prohibited inside the examination center.</li>
                        <li>Candidates must report to the examination center at least <strong>30 minutes</strong> before the scheduled start time.</li>
                    </ul>
                </div>
                <div class="col-4 d-flex flex-column justify-content-end text-center">
                    <div class="border-top border-dark pt-1 fw-bold text-navy" style="margin-top:40px;">
                        Controller of Examinations<br />
                        <small class="text-muted fw-normal">Shah Abdul Latif University</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ApplicationUser? user;
    private EntityEnrollment? enrollment;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                enrollment = await Db.Enrollments
                    .Include(e => e.College)
                    .Include(e => e.Seat)
                    .Include(e => e.AdmitCard)
                    .OrderByDescending(e => e.CreatedAt)
                    .FirstOrDefaultAsync(e => e.UserId == user.Id);
            }
        }
        loading = false;

        if (enrollment?.AdmitCard == null)
            Toast.ShowWarning("Admit card not yet issued. Check back after fee verification.");
        else
            Toast.ShowInfo("Your admit card is ready to print.");
    }

    private async Task PrintAdmitCard()
    {
        Toast.ShowSuccess("Printing admit card…");
        await JS.InvokeVoidAsync("window.print");
    }
}
